import Applied.Statistics.SPRTWald
import Applied.Statistics.SPRT
import Mathlib.Probability.Independence.Integration

/-!
# Wald's change of measure for i.i.d. observations

Observations `X 0, X 1, …` are independent under each of two probability measures `P₀, P₁`,
with laws `ν.withDensity p₀` under `P₀` and `ν.withDensity p₁` under `P₁`, where `p₀ > 0`
everywhere. Let `F n` be the σ-algebra generated by `X 0, …, X (n-1)` (`obsFiltration`). Then
the likelihood ratio `Λ n = ∏ i < n, p₁ (X i) / p₀ (X i)` is the density of `P₁` with respect
to `P₀` on `F n` (`wald_density_iid`), so the abstract hypotheses `WaldSetup` hold for every
`F`-stopping time (`waldSetup_iid`), and Wald's bounds `α ≤ (1 - β) / A`, `β ≤ B (1 - α)` follow
(`sprt_alpha_le_iid`, `sprt_beta_le_iid`).
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace Applied.Sequential

variable {Ω E : Type*} {m0 : MeasurableSpace Ω} [MeasurableSpace E]

/-- The first `n` observations as a vector. -/
def obsVec (X : ℕ → Ω → E) (n : ℕ) (ω : Ω) : Fin n → E := fun i => X i ω

/-- The σ-algebra generated by the first `n` observations `X 0, …, X (n-1)`. -/
def obsFiltration (X : ℕ → Ω → E) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (obsVec X n) inferInstance

lemma measurable_obsVec {X : ℕ → Ω → E} (hX : ∀ i, Measurable (X i)) (n : ℕ) :
    Measurable (obsVec X n) :=
  measurable_pi_iff.mpr fun i => hX i

lemma obsFiltration_le {X : ℕ → Ω → E} (hX : ∀ i, Measurable (X i)) (n : ℕ) :
    obsFiltration X n ≤ m0 :=
  (measurable_obsVec hX n).comap_le

variable {p₀ p₁ : E → ℝ} {ν : Measure E} {P₀ P₁ : Measure Ω} {X : ℕ → Ω → E}

omit [MeasurableSpace E] in
lemma likelihoodRatioProcess_eq_comp (n : ℕ) :
    likelihoodRatioProcess p₀ p₁ X n =
      (fun v : Fin n → E => ∏ i : Fin n, p₁ (v i) / p₀ (v i)) ∘ obsVec X n := by
  funext ω
  rw [likelihoodRatioProcess_apply, Function.comp_apply]
  exact (Fin.prod_univ_eq_prod_range (fun i => p₁ (X i ω) / p₀ (X i ω)) n).symm

lemma measurable_obsFiltration_likelihoodRatioProcess (hm₀ : Measurable p₀)
    (hm₁ : Measurable p₁) (n : ℕ) :
    Measurable[obsFiltration X n] (likelihoodRatioProcess p₀ p₁ X n) := by
  rw [likelihoodRatioProcess_eq_comp]
  refine Measurable.comp ?_ (comap_measurable _)
  exact Finset.measurable_prod _ fun i _ =>
    (hm₁.comp (measurable_pi_apply i)).div (hm₀.comp (measurable_pi_apply i))

/-- One coordinate: `E₀[1_s(X) · p₁(X)/p₀(X)] = P₁(X ∈ s)`. -/
lemma lintegral_indicator_ratio {Y : Ω → E} (hY : Measurable Y)
    (h0 : P₀.map Y = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : P₁.map Y = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    {s : Set E} (hs : MeasurableSet s) :
    ∫⁻ ω, s.indicator (fun x => ENNReal.ofReal (p₁ x / p₀ x)) (Y ω) ∂P₀ = P₁ (Y ⁻¹' s) := by
  have hr : Measurable fun x => ENNReal.ofReal (p₁ x / p₀ x) := (hm₁.div hm₀).ennreal_ofReal
  rw [← lintegral_map ((hr.indicator hs)) hY, h0, lintegral_indicator hs,
    setLIntegral_withDensity_eq_setLIntegral_mul _ hm₀.ennreal_ofReal hr hs,
    ← Measure.map_apply hY hs, h1, withDensity_apply _ hs]
  refine setLIntegral_congr_fun hs fun x _ => ?_
  simp only [Pi.mul_apply]
  rw [← ENNReal.ofReal_mul (hp₀ x).le, mul_div_cancel₀ _ (hp₀ x).ne']

/-- Boxes: `∫⁻_{(X 0, …, X (n-1)) ∈ ∏ s i} Λ n dP₀ = ∏ P₁ (X i ∈ s i)`. -/
lemma setLIntegral_box (hX : ∀ i, Measurable (X i)) (hind₀ : iIndepFun X P₀)
    (h0 : ∀ i, P₀.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : ∀ i, P₁.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    (n : ℕ) (s : Fin n → Set E) (hs : ∀ i, MeasurableSet (s i)) :
    ∫⁻ ω in obsVec X n ⁻¹' Set.univ.pi s,
        ENNReal.ofReal (likelihoodRatioProcess p₀ p₁ X n ω) ∂P₀ =
      ∏ i : Fin n, P₁ (X i ⁻¹' s i) := by
  set r : E → ℝ≥0∞ := fun x => ENNReal.ofReal (p₁ x / p₀ x) with hrdef
  have hr : Measurable r := (hm₁.div hm₀).ennreal_ofReal
  have hpt : ∀ ω, (obsVec X n ⁻¹' Set.univ.pi s).indicator
      (fun ω => ENNReal.ofReal (likelihoodRatioProcess p₀ p₁ X n ω)) ω =
      ∏ i : Fin n, (s i).indicator r (X i ω) := by
    intro ω
    have hΛ : ENNReal.ofReal (likelihoodRatioProcess p₀ p₁ X n ω) = ∏ i : Fin n, r (X i ω) := by
      rw [likelihoodRatioProcess_eq_comp, Function.comp_apply,
        ENNReal.ofReal_prod_of_nonneg fun i _ => div_nonneg (hp₁ _) (hp₀ _).le]
      rfl
    by_cases hω : ∀ i, X i ω ∈ s i
    · have hmem : ω ∈ obsVec X n ⁻¹' Set.univ.pi s := by
        simpa [obsVec, Set.mem_univ_pi] using hω
      rw [Set.indicator_of_mem hmem, hΛ]
      exact Finset.prod_congr rfl fun i _ => (Set.indicator_of_mem (hω i) _).symm
    · obtain ⟨i, hi⟩ := not_forall.1 hω
      have hmem : ω ∉ obsVec X n ⁻¹' Set.univ.pi s := by
        simp only [Set.mem_preimage, Set.mem_univ_pi, not_forall]
        exact ⟨i, hi⟩
      rw [Set.indicator_of_notMem hmem]
      exact (Finset.prod_eq_zero (Finset.mem_univ i) (Set.indicator_of_notMem hi _)).symm
  have hVs : MeasurableSet (obsVec X n ⁻¹' Set.univ.pi s) :=
    measurable_obsVec hX n (MeasurableSet.univ_pi hs)
  rw [← lintegral_indicator hVs]
  simp_rw [hpt]
  have hind : iIndepFun (fun i : Fin n => fun ω => (s i).indicator r (X i ω)) P₀ := by
    have h := (hind₀.precomp (g := fun i : Fin n => (i : ℕ)) Fin.val_injective).comp
      (fun i => (s i).indicator r) fun i => hr.indicator (hs i)
    exact h
  rw [lintegral_prod_eq_prod_lintegral_of_indepFun Finset.univ _ hind
    fun i => (hr.indicator (hs i)).comp (hX i)]
  exact Finset.prod_congr rfl fun i _ =>
    lintegral_indicator_ratio (hX i) (h0 i) (h1 i) hp₀ hm₀ hm₁ (hs i)

variable [IsProbabilityMeasure P₀] [IsProbabilityMeasure P₁]

omit [IsProbabilityMeasure P₀] in
/-- **The likelihood ratio is the density of `P₁` with respect to `P₀` on `F n`.** -/
theorem wald_density_iid (hX : ∀ i, Measurable (X i)) (hind₀ : iIndepFun X P₀)
    (hind₁ : iIndepFun X P₁)
    (h0 : ∀ i, P₀.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : ∀ i, P₁.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    (n : ℕ) (S : Set Ω) (hS : MeasurableSet[obsFiltration X n] S) :
    P₁ S = ∫⁻ ω in S, ENNReal.ofReal (likelihoodRatioProcess p₀ p₁ X n ω) ∂P₀ := by
  obtain ⟨B, hB, rfl⟩ := hS
  have hV := measurable_obsVec hX n
  set Q : Measure Ω := P₀.withDensity
    fun ω => ENNReal.ofReal (likelihoodRatioProcess p₀ p₁ X n ω) with hQ
  have h1V : P₁.map (obsVec X n) = Measure.pi fun i : Fin n => P₁.map (X i) :=
    (hind₁.precomp (g := fun i : Fin n => (i : ℕ)) Fin.val_injective).map_fun_eq_pi_map
      fun i => (hX i).aemeasurable
  have hQV : Measure.pi (fun i : Fin n => P₁.map (X i)) = Q.map (obsVec X n) := by
    refine Measure.pi_eq fun s hs => ?_
    rw [Measure.map_apply hV (MeasurableSet.univ_pi hs), hQ, withDensity_apply _
      (hV (MeasurableSet.univ_pi hs)),
      setLIntegral_box hX hind₀ h0 h1 hp₀ hp₁ hm₀ hm₁ n s hs]
    exact Finset.prod_congr rfl fun i _ => (Measure.map_apply (hX i) (hs i)).symm
  rw [← Measure.map_apply hV hB, h1V, hQV, Measure.map_apply hV hB, hQ, withDensity_apply _ (hV hB)]

omit [IsProbabilityMeasure P₀] in
/-- The abstract change-of-measure setup holds for i.i.d. observations and any stopping time of
the observation filtration. -/
theorem waldSetup_iid (hX : ∀ i, Measurable (X i)) (hind₀ : iIndepFun X P₀)
    (hind₁ : iIndepFun X P₁)
    (h0 : ∀ i, P₀.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : ∀ i, P₁.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    {τ : Ω → ℕ∞} (hτ : ∀ n, MeasurableSet[obsFiltration X n] {ω | τ ω = n}) :
    WaldSetup P₀ P₁ (obsFiltration X) (likelihoodRatioProcess p₀ p₁ X) τ where
  le := obsFiltration_le hX
  stop := hτ
  adapted := measurable_obsFiltration_likelihoodRatioProcess hm₀ hm₁
  density := wald_density_iid hX hind₀ hind₁ h0 h1 hp₀ hp₁ hm₀ hm₁

/-- **Wald's `A α ≤ 1 - β` for i.i.d. observations.** -/
theorem sprt_alpha_le_iid (hX : ∀ i, Measurable (X i)) (hind₀ : iIndepFun X P₀)
    (hind₁ : iIndepFun X P₁)
    (h0 : ∀ i, P₀.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : ∀ i, P₁.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    {τ : Ω → ℕ∞} (hτ : ∀ n, MeasurableSet[obsFiltration X n] {ω | τ ω = n}) (A : ℝ)
    {Acc : Set Ω} (hAcc : MeasurableSet Acc)
    (hdisj : Disjoint Acc (stoppedEvent τ (likelihoodRatioProcess p₀ p₁ X) (· ∈ Set.Ici A))) :
    ENNReal.ofReal A * P₀ (stoppedEvent τ (likelihoodRatioProcess p₀ p₁ X) (· ∈ Set.Ici A)) ≤
      1 - P₁ Acc :=
  wald_alpha_le (waldSetup_iid hX hind₀ hind₁ h0 h1 hp₀ hp₁ hm₀ hm₁ hτ) A hAcc hdisj

/-- **Wald's `β ≤ B (1 - α)` for i.i.d. observations.** -/
theorem sprt_beta_le_iid (hX : ∀ i, Measurable (X i)) (hind₀ : iIndepFun X P₀)
    (hind₁ : iIndepFun X P₁)
    (h0 : ∀ i, P₀.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    (h1 : ∀ i, P₁.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₁ x))
    (hp₀ : ∀ x, 0 < p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    {τ : Ω → ℕ∞} (hτ : ∀ n, MeasurableSet[obsFiltration X n] {ω | τ ω = n}) (B : ℝ)
    {Rej : Set Ω} (hRej : MeasurableSet Rej)
    (hdisj : Disjoint Rej (stoppedEvent τ (likelihoodRatioProcess p₀ p₁ X) (· ∈ Set.Iic B))) :
    P₁ (stoppedEvent τ (likelihoodRatioProcess p₀ p₁ X) (· ∈ Set.Iic B)) ≤
      ENNReal.ofReal B * (1 - P₀ Rej) :=
  wald_beta_le (waldSetup_iid hX hind₀ hind₁ h0 h1 hp₀ hp₁ hm₀ hm₁ hτ) B hRej hdisj

end Applied.Sequential
