import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.Probability.Moments.Covariance
import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.HasLaw

/-!
# Group-sequential designs: the canonical joint distribution

Interim analyses of a trial with independent standard normal increments `ξ 0, ξ 1, …` look at
the partial sums `S n = ∑ i < n, ξ i` at information times `n₁ ≤ n₂ ≤ …` and at the
standardised statistics `Z n = S n / √n`. The *canonical joint distribution* says that the
`Z`'s are standard normal with `Cov (Z a, Z b) = √(a / b)` for `a ≤ b`, and that the increments
of `S` between consecutive looks are independent.

## Main results

Second-order structure (no normality: pairwise independent, square-integrable, variance one):

* `covariance_partialSum`: `cov (S a, S b) = min a b`.
* `covariance_zStat`: `cov (Z a, Z b) = √(a / b)` for `0 < a ≤ b`.

Independence of blocks (general):

* `iIndep_biSup_of_pairwise_disjoint`: for independent σ-algebras `m i` and pairwise disjoint
  index sets `S k`, the σ-algebras `⨆ i ∈ S k, m i` are independent.
* `iIndepFun_blockSum`: sums of an independent family over pairwise disjoint finite blocks
  are independent.

Independent standard normal increments (`Measurable (ξ i)`, `P.map (ξ i) = gaussianReal 0 1`,
`iIndepFun ξ P`):

* `map_partialSum`: `S n` has law `N(0, n)`.
* `map_partialSum_sub`: `S b - S a` has law `N(0, b - a)` for `a ≤ b`.
* `map_zStat`: `Z n` has law `N(0, 1)` for `n > 0`.
* `iIndepFun_increments`: for monotone look times `t`, the increments
  `S (t (k + 1)) - S (t k)` are mutually independent.
* `covariance_zStat_of_gaussian`: `cov (Z a, Z b) = √(a / b)` for `0 < a ≤ b`.

Not proved here: that the vector `(Z n₁, …, Z n_K)` is multivariate normal as a statement about
its joint law on `ℝ^K` (it is a linear image of independent normal increments, but that
statement is not formalised), and anything about boundaries computed from this distribution.
-/

open MeasureTheory ProbabilityTheory Finset
open scoped ENNReal NNReal

namespace Applied.GroupSequential

section Blocks

variable {Ω ι κ : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}

/-- For mutually independent σ-algebras `m i` and pairwise disjoint index sets `S k`, the
σ-algebras `⨆ i ∈ S k, m i` generated by the blocks are mutually independent. -/
theorem iIndep_biSup_of_pairwise_disjoint {m : ι → MeasurableSpace Ω} (h_le : ∀ i, m i ≤ mΩ)
    (h_indep : iIndep m μ) {S : κ → Set ι} (hS : Pairwise (Function.onFun Disjoint S)) :
    iIndep (fun k => ⨆ i ∈ S k, m i) μ := by
  classical
  refine iIndepSets.iIndep (fun k => iSup₂_le fun i _ => h_le i)
    (fun k => piiUnionInter (fun n => {s | MeasurableSet[m n] s}) (S k))
    (fun k => isPiSystem_piiUnionInter _ (fun n => @MeasurableSpace.isPiSystem_measurableSet Ω (m n)) _)
    (fun k => (generateFrom_piiUnionInter_measurableSet m (S k)).symm) ?_
  rw [iIndepSets_iff]
  intro T f hf
  choose! t ht g hg hfg using hf
  set G : ι → Set Ω := fun i => ⋂ k ∈ T, if i ∈ t k then g k i else Set.univ with hG
  have hGeq : ∀ k ∈ T, ∀ i ∈ t k, G i = g k i := by
    intro k hk i hi
    ext ω
    simp only [hG, Set.mem_iInter]
    constructor
    · intro h
      simpa [hi] using h k hk
    · intro h k' hk'
      by_cases hik' : i ∈ t k'
      · have hkk : k' = k := by
          by_contra hne
          exact Set.disjoint_left.mp (hS hne) (ht k' hk' hik') (ht k hk hi)
        subst hkk
        simpa [hik'] using h
      · simp [hik']
  have hGmeas : ∀ i, i ∈ T.biUnion t → MeasurableSet[m i] (G i) := by
    intro i hi
    obtain ⟨k, hk, hik⟩ := Finset.mem_biUnion.mp hi
    rw [hGeq k hk i hik]
    exact hg k hk i hik
  have hInter : ⋂ k ∈ T, f k = ⋂ i ∈ T.biUnion t, G i := by
    ext ω
    simp only [Set.mem_iInter, Finset.mem_biUnion]
    constructor
    · rintro h i ⟨k, hk, hik⟩
      rw [hGeq k hk i hik]
      have h' := h k hk
      rw [hfg k hk] at h'
      exact Set.mem_iInter₂.mp h' i hik
    · intro h k hk
      rw [hfg k hk]
      refine Set.mem_iInter₂.mpr fun i hik => ?_
      rw [← hGeq k hk i hik]
      exact h i ⟨k, hk, hik⟩
  rw [hInter, h_indep.meas_biInter hGmeas, Finset.prod_biUnion]
  · refine Finset.prod_congr rfl fun k hk => ?_
    rw [hfg k hk, h_indep.meas_biInter (fun i hi => hg k hk i hi)]
    exact Finset.prod_congr rfl fun i hi => by rw [hGeq k hk i hi]
  · intro k hk k' hk' hne
    exact Finset.disjoint_left.mpr fun i hi hi' =>
      Set.disjoint_left.mp (hS hne) (ht k hk hi) (ht k' hk' hi')

/-- Sums of a mutually independent family of measurable real random variables over pairwise
disjoint finite blocks of indices are mutually independent. -/
theorem iIndepFun_blockSum {ξ : ι → Ω → ℝ} (hξ : ∀ i, Measurable (ξ i))
    (hindep : iIndepFun ξ μ) {S : κ → Finset ι} (hS : Pairwise (Function.onFun Disjoint S)) :
    iIndepFun (fun k ω => ∑ i ∈ S k, ξ i ω) μ := by
  have h := iIndep_biSup_of_pairwise_disjoint
    (m := fun i => MeasurableSpace.comap (ξ i) inferInstance) (fun i => (hξ i).comap_le) hindep
    (S := fun k => (S k : Set ι)) (fun k k' hne => by
      simpa [Function.onFun] using hS hne)
  rw [iIndepFun_iff_iIndep]
  rw [iIndep_iff] at h ⊢
  intro T f H
  refine h T fun k hk => ?_
  have hmeas : Measurable[⨆ i ∈ (S k : Set ι), MeasurableSpace.comap (ξ i) inferInstance]
      (fun ω => ∑ i ∈ S k, ξ i ω) :=
    Finset.measurable_fun_sum _ fun i hi =>
      (comap_measurable (ξ i)).mono
        (le_biSup (fun j => MeasurableSpace.comap (ξ j) inferInstance) (Finset.mem_coe.mpr hi))
        le_rfl
  exact hmeas.comap_le _ (H k hk)

end Blocks

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {ξ : ℕ → Ω → ℝ}

/-- The partial sum `S n = ∑ i < n, ξ i`. -/
def partialSum (ξ : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ := ∑ i ∈ range n, ξ i ω

/-- The standardised statistic `Z n = S n / √n`. -/
noncomputable def zStat (ξ : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ := partialSum ξ n ω / √(n : ℝ)

section SecondOrder

/-- **Covariance of partial sums.** For pairwise independent square-integrable random
variables of variance one, `cov (S a, S b) = min a b`. -/
theorem covariance_partialSum [IsProbabilityMeasure P] (hL2 : ∀ i, MemLp (ξ i) 2 P)
    (hindep : Pairwise fun i j => ξ i ⟂ᵢ[P] ξ j) (hvar : ∀ i, Var[ξ i; P] = 1) (a b : ℕ) :
    cov[partialSum ξ a, partialSum ξ b; P] = (min a b : ℕ) := by
  have hcov : ∀ i j, cov[ξ i, ξ j; P] = if i = j then 1 else 0 := by
    intro i j
    split_ifs with h
    · subst h
      rw [covariance_self (hL2 i).aestronglyMeasurable.aemeasurable, hvar]
    · exact (hindep h).covariance_eq_zero (hL2 i) (hL2 j)
  have hfilter : (range a).filter (fun i => i ∈ range b) = range (min a b) := by
    ext i; simp [lt_min_iff]
  change cov[fun ω => ∑ i ∈ range a, ξ i ω, fun ω => ∑ j ∈ range b, ξ j ω; P] = _
  rw [covariance_fun_sum_fun_sum' (fun i _ => hL2 i) (fun j _ => hL2 j)]
  simp_rw [hcov, Finset.sum_ite_eq]
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, hfilter]
  simp

/-- **Covariance of the standardised statistics.** For pairwise independent square-integrable
random variables of variance one and `0 < a ≤ b`, `cov (Z a, Z b) = √(a / b)`. -/
theorem covariance_zStat [IsProbabilityMeasure P] (hL2 : ∀ i, MemLp (ξ i) 2 P)
    (hindep : Pairwise fun i j => ξ i ⟂ᵢ[P] ξ j) (hvar : ∀ i, Var[ξ i; P] = 1) {a b : ℕ}
    (ha : 0 < a) (hab : a ≤ b) :
    cov[zStat ξ a, zStat ξ b; P] = √((a : ℝ) / b) := by
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hb' : (0 : ℝ) < b := by exact_mod_cast lt_of_lt_of_le ha hab
  change cov[fun ω => partialSum ξ a ω / √(a : ℝ), fun ω => partialSum ξ b ω / √(b : ℝ); P] = _
  simp_rw [div_eq_mul_inv]
  rw [covariance_mul_const_left, covariance_mul_const_right,
    covariance_partialSum hL2 hindep hvar, min_eq_left hab, Real.sqrt_mul ha'.le,
    Real.sqrt_inv]
  have hsa : √(a : ℝ) ≠ 0 := (Real.sqrt_pos.mpr ha').ne'
  have hsb : √(b : ℝ) ≠ 0 := (Real.sqrt_pos.mpr hb').ne'
  field_simp
  exact (Real.sq_sqrt ha'.le).symm

end SecondOrder

section Gaussian

variable [IsProbabilityMeasure P]

/-- The sum of independent standard normal variables over a finite set `s` of indices has law
`N(0, |s|)`. -/
theorem map_blockSum (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) (s : Finset ℕ) :
    P.map (fun ω => ∑ i ∈ s, ξ i ω) = gaussianReal 0 (s.card : ℝ≥0) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [Measure.map_const]
  | insert i s hi ih =>
    have hsum : (∑ j ∈ s, ξ j) = fun ω => ∑ j ∈ s, ξ j ω := by
      ext ω; simp
    have hind : (fun ω => ∑ j ∈ s, ξ j ω) ⟂ᵢ[P] ξ i := by
      rw [← hsum]; exact hindep.indepFun_finsetSum_of_notMem hξ hi
    have h1 : HasLaw (fun ω => ∑ j ∈ s, ξ j ω) (gaussianReal 0 (s.card : ℝ≥0)) P :=
      ⟨(Finset.measurable_fun_sum _ fun j _ => hξ j).aemeasurable, ih⟩
    have h2 : HasLaw (ξ i) (gaussianReal 0 1) P := ⟨(hξ i).aemeasurable, hlaw i⟩
    have h := gaussianReal_add_gaussianReal_of_indepFun hind h1 h2
    have hfun : (fun ω => ∑ j ∈ insert i s, ξ j ω) = (fun ω => ∑ j ∈ s, ξ j ω) + ξ i := by
      ext ω; simp [Finset.sum_insert hi, add_comm]
    rw [hfun, h, Finset.card_insert_of_notMem hi]
    simp

/-- `S n` has law `N(0, n)`. -/
theorem map_partialSum (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) (n : ℕ) :
    P.map (partialSum ξ n) = gaussianReal 0 (n : ℝ≥0) := by
  have h := map_blockSum hξ hlaw hindep (range n)
  rw [Finset.card_range] at h
  exact h

lemma partialSum_sub (ξ : ℕ → Ω → ℝ) {a b : ℕ} (hab : a ≤ b) (ω : Ω) :
    partialSum ξ b ω - partialSum ξ a ω = ∑ i ∈ Ico a b, ξ i ω :=
  (Finset.sum_Ico_eq_sub (fun i => ξ i ω) hab).symm

/-- The increment `S b - S a` has law `N(0, b - a)` for `a ≤ b`. -/
theorem map_partialSum_sub (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {a b : ℕ}
    (hab : a ≤ b) :
    P.map (fun ω => partialSum ξ b ω - partialSum ξ a ω) = gaussianReal 0 ((b - a : ℕ) : ℝ≥0) := by
  simp_rw [partialSum_sub ξ hab]
  simpa using map_blockSum hξ hlaw hindep (Ico a b)

lemma measurable_partialSum (hξ : ∀ i, Measurable (ξ i)) (n : ℕ) :
    Measurable (partialSum ξ n) :=
  Finset.measurable_fun_sum _ fun i _ => hξ i

/-- `Z n = S n / √n` is standard normal for `n > 0`. -/
theorem map_zStat (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n : ℕ}
    (hn : 0 < n) : P.map (zStat ξ n) = gaussianReal 0 1 := by
  have h1 : HasLaw (partialSum ξ n) (gaussianReal 0 (n : ℝ≥0)) P :=
    ⟨(measurable_partialSum hξ n).aemeasurable, map_partialSum hξ hlaw hindep n⟩
  have h := (gaussianReal_div_const h1 (√(n : ℝ))).map_eq
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hv : (n : ℝ≥0) / .mk (√(n : ℝ) ^ 2) (sq_nonneg _) = 1 := by
    apply NNReal.eq
    simp only [NNReal.coe_div, NNReal.coe_natCast, NNReal.coe_mk, Real.sq_sqrt hn'.le,
      NNReal.coe_one]
    exact div_self hn'.ne'
  rw [hv, zero_div] at h
  exact h

omit [IsProbabilityMeasure P] in
/-- **Independent increments.** For monotone look times `t`, the increments
`S (t (k + 1)) - S (t k)` of the partial-sum process between consecutive looks are mutually
independent. With `t 0 = 0` the family starts with `S (t 1)` itself. Only independence and
measurability of the `ξ i` are used. -/
theorem iIndepFun_increments (hξ : ∀ i, Measurable (ξ i)) (hindep : iIndepFun ξ P)
    {t : ℕ → ℕ} (ht : Monotone t) :
    iIndepFun (fun k ω => partialSum ξ (t (k + 1)) ω - partialSum ξ (t k) ω) P := by
  have hdisj : Pairwise (Function.onFun Disjoint fun k => Ico (t k) (t (k + 1))) := by
    intro k k' hne
    refine Finset.disjoint_left.mpr fun i hi hi' => ?_
    rw [Finset.mem_Ico] at hi hi'
    rcases lt_or_gt_of_ne hne with h | h
    · have := ht (show k + 1 ≤ k' from h); omega
    · have := ht (show k' + 1 ≤ k from h); omega
  have h := iIndepFun_blockSum hξ hindep hdisj
  have heq : (fun k ω => partialSum ξ (t (k + 1)) ω - partialSum ξ (t k) ω) =
      fun k ω => ∑ i ∈ Ico (t k) (t (k + 1)), ξ i ω := by
    ext k ω
    exact partialSum_sub ξ (ht (Nat.le_succ k)) ω
  rw [heq]
  exact h

/-- **Canonical covariance.** For independent standard normal `ξ i` and `0 < a ≤ b`,
`cov (Z a, Z b) = √(a / b)`. -/
theorem covariance_zStat_of_gaussian (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {a b : ℕ}
    (ha : 0 < a) (hab : a ≤ b) :
    cov[zStat ξ a, zStat ξ b; P] = √((a : ℝ) / b) := by
  have hL : ∀ i, HasLaw (ξ i) (gaussianReal 0 1) P := fun i => ⟨(hξ i).aemeasurable, hlaw i⟩
  refine covariance_zStat (fun i => (hL i).memLp (memLp_id_gaussianReal 2))
    (fun i j hij => hindep.indepFun hij) (fun i => ?_) ha hab
  rw [(hL i).variance_eq, variance_id_gaussianReal]
  simp

end Gaussian

end Applied.GroupSequential
