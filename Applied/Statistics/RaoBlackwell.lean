import Mathlib.Probability.CondVar

/-!
# Rao–Blackwell theorem (variance form)

Conditioning an estimator on any sub-σ-algebra does not increase its variance:
`Var(E[T | m]) ≤ Var(T)`. Conditioning preserves the mean, so when `m` is generated by a
sufficient statistic, `E[T | m]` is an estimator with the same bias and no larger variance.
Sufficiency itself (that `E[T | m]` does not depend on the parameter) is not treated here.
-/

open MeasureTheory ProbabilityTheory

namespace Applied.Statistics

variable {Ω : Type*} {m m₀ : MeasurableSpace Ω} {P : Measure[m₀] Ω}

/-- **Rao–Blackwell inequality.** -/
theorem variance_condExp_le (hm : m ≤ m₀) [IsProbabilityMeasure P] {T : Ω → ℝ}
    (hT : MemLp T 2 P) : Var[P[T | m]; P] ≤ Var[T; P] := by
  have htot := integral_condVar_add_variance_condExp hm hT
  have hnonneg : 0 ≤ P[Var[T; P | m]] := by
    rw [condVar, integral_condExp hm]
    exact integral_nonneg fun ω => sq_nonneg _
  linarith

/-- Conditioning preserves the mean. -/
theorem integral_condExp_eq (hm : m ≤ m₀) [IsProbabilityMeasure P] (T : Ω → ℝ) :
    ∫ ω, (P[T | m]) ω ∂P = ∫ ω, T ω ∂P :=
  integral_condExp hm

end Applied.Statistics
