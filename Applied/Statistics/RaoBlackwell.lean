import Mathlib.Probability.CondVar

/-!
# Rao–Blackwell theorem (variance form)

Conditioning an estimator on any sub-σ-algebra does not increase its variance:
`Var(E[T | m]) ≤ Var(T)`. Conditioning preserves the mean, so when `m` is generated by a
sufficient statistic, `E[T | m]` is an estimator with the same bias and no larger variance.
Sufficiency itself (that `E[T | m]` does not depend on the parameter) is not treated here.

* `variance_condExp_le`: the Rao–Blackwell inequality `Var(E[T | m]) ≤ Var(T)`.
* `integral_condExp_eq`: `E[E[T | m]] = E[T]`.

Both are stated for a single probability measure `P`; a statistical model enters only in
`LehmannScheffe.lean`, which applies this file to every member of a family `P θ` and adds
completeness to get the minimum-variance unbiased estimator. Sufficiency on a finite sample
space (the Fisher–Neyman factorization) is in `FisherNeyman.lean`. Not here: the general
convex-loss form of Rao–Blackwell (Jensen's inequality for conditional expectations), and
vector-valued estimators.
-/

open MeasureTheory ProbabilityTheory

namespace Applied.Statistics

variable {Ω : Type*} {m m₀ : MeasurableSpace Ω} {P : Measure[m₀] Ω}

/-- **Rao–Blackwell inequality** (variance form). For a square-integrable real random variable
`T` (an estimator) on a probability space and any sub-σ-algebra `m` (the information carried by
a statistic), the conditional expectation `E[T | m]` has variance at most that of `T`:
`Var(E[T | m]) ≤ Var(T)`. This is the law of total variance
`Var(T) = E[Var(T | m)] + Var(E[T | m])` with the first term dropped. -/
theorem variance_condExp_le (hm : m ≤ m₀) [IsProbabilityMeasure P] {T : Ω → ℝ}
    (hT : MemLp T 2 P) : Var[P[T | m]; P] ≤ Var[T; P] := by
  have htot := integral_condVar_add_variance_condExp hm hT
  have hnonneg : 0 ≤ P[Var[T; P | m]] := by
    rw [condVar, integral_condExp hm]
    exact integral_nonneg fun ω => sq_nonneg _
  linarith

/-- Conditioning preserves the mean: `E[E[T | m]] = E[T]`. Hence the Rao–Blackwellised
estimator `E[T | m]` has the same bias as `T`. (Restatement of Mathlib's `integral_condExp`.) -/
theorem integral_condExp_eq (hm : m ≤ m₀) [IsProbabilityMeasure P] (T : Ω → ℝ) :
    ∫ ω, (P[T | m]) ω ∂P = ∫ ω, T ω ∂P :=
  integral_condExp hm

end Applied.Statistics
