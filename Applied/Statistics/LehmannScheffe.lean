import Applied.Statistics.RaoBlackwell

/-!
# Lehmann–Scheffé theorem

Let `P θ` be a family of probability measures and `m` a sub-σ-algebra (thought of as the
σ-algebra generated by a statistic `T`).

* `IsCompleteSubalgebra P m` (completeness): every `m`-measurable `g` that is integrable with
  mean zero under every `P θ` vanishes `P θ`-almost surely for every `θ`.
* `HasCommonCondExp P m V` (what sufficiency of `m` provides for the estimator `V`): there is
  a single `m`-measurable function that is a version of the conditional expectation
  `E_θ[V | m]` for every `θ`.

`variance_le_of_isCompleteSubalgebra` is the **Lehmann–Scheffé theorem**: if `m` is complete,
`U` is `m`-measurable and unbiased for `τ`, then `U` has variance at most that of any unbiased
estimator `V` of `τ` whose conditional expectation given `m` has a parameter-free version,
under every `P θ`. Estimators are square integrable under every `P θ`.

The proof: `U - E[V | m]` is `m`-measurable with mean zero under every `θ`, hence zero almost
surely by completeness, and `Var(E[V | m]) ≤ Var(V)` by Rao–Blackwell.
-/

open MeasureTheory ProbabilityTheory

namespace Applied.Statistics

variable {Ω Θ : Type*} {m m₀ : MeasurableSpace Ω} {P : Θ → Measure[m₀] Ω}

/-- **Completeness** of the sub-σ-algebra `m` for the family `P`: the only `m`-measurable
functions with mean zero under every member of the family are those that vanish almost surely
under every member. -/
def IsCompleteSubalgebra (P : Θ → Measure[m₀] Ω) (m : MeasurableSpace Ω) : Prop :=
  ∀ g : Ω → ℝ, StronglyMeasurable[m] g → (∀ θ, Integrable g (P θ)) → (∀ θ, ∫ ω, g ω ∂P θ = 0) →
    ∀ θ, g =ᵐ[P θ] 0

/-- The conditional expectation of `V` given `m` has a version that does not depend on the
parameter. This is the consequence of sufficiency of `m` that the Lehmann–Scheffé theorem
uses. -/
def HasCommonCondExp (P : Θ → Measure[m₀] Ω) (m : MeasurableSpace Ω) (V : Ω → ℝ) : Prop :=
  ∃ W : Ω → ℝ, StronglyMeasurable[m] W ∧ ∀ θ, W =ᵐ[P θ] (P θ)[V | m]

/-- Under completeness, two `m`-measurable estimators with the same mean under every member of
the family agree almost surely under every member. -/
theorem ae_eq_of_isCompleteSubalgebra (hc : IsCompleteSubalgebra P m) {U W : Ω → ℝ}
    (hU : StronglyMeasurable[m] U) (hW : StronglyMeasurable[m] W)
    (hUi : ∀ θ, Integrable U (P θ)) (hWi : ∀ θ, Integrable W (P θ))
    (hmean : ∀ θ, ∫ ω, U ω ∂P θ = ∫ ω, W ω ∂P θ) (θ : Θ) : U =ᵐ[P θ] W := by
  have h := hc (fun ω => U ω - W ω) (hU.sub hW) (fun θ => (hUi θ).sub (hWi θ))
    (fun θ => by rw [integral_sub (hUi θ) (hWi θ), hmean θ, sub_self]) θ
  filter_upwards [h] with ω hω
  exact sub_eq_zero.mp hω

/-- Under completeness, an `m`-measurable unbiased estimator is almost surely equal to the
conditional expectation given `m` of any other unbiased estimator of the same quantity, as soon
as that conditional expectation has a parameter-free version. -/
theorem ae_eq_condExp_of_isCompleteSubalgebra (hm : m ≤ m₀) [∀ θ, IsProbabilityMeasure (P θ)]
    (hc : IsCompleteSubalgebra P m) {U V : Ω → ℝ} {τ : Θ → ℝ}
    (hU : StronglyMeasurable[m] U) (hUi : ∀ θ, Integrable U (P θ))
    (hUmean : ∀ θ, ∫ ω, U ω ∂P θ = τ θ) (hVmean : ∀ θ, ∫ ω, V ω ∂P θ = τ θ)
    (hV : HasCommonCondExp P m V) (θ : Θ) : U =ᵐ[P θ] (P θ)[V | m] := by
  obtain ⟨W, hW, hWV⟩ := hV
  have hWi : ∀ θ, Integrable W (P θ) := fun θ => integrable_condExp.congr (hWV θ).symm
  have hWmean : ∀ θ, ∫ ω, W ω ∂P θ = τ θ := fun θ => by
    rw [integral_congr_ae (hWV θ), integral_condExp hm, hVmean θ]
  exact (ae_eq_of_isCompleteSubalgebra hc hU hW hUi hWi
    (fun θ => by rw [hUmean θ, hWmean θ]) θ).trans (hWV θ)

/-- **Lehmann–Scheffé theorem.** If the sub-σ-algebra `m` is complete for the family `P`, an
`m`-measurable unbiased estimator `U` of `τ` has, under every `P θ`, variance at most that of
any square-integrable unbiased estimator `V` of `τ` whose conditional expectation given `m` has
a parameter-free version (as is the case for every `V` when `m` is sufficient). -/
theorem variance_le_of_isCompleteSubalgebra (hm : m ≤ m₀) [∀ θ, IsProbabilityMeasure (P θ)]
    (hc : IsCompleteSubalgebra P m) {U V : Ω → ℝ} {τ : Θ → ℝ}
    (hU : StronglyMeasurable[m] U) (hUi : ∀ θ, Integrable U (P θ))
    (hUmean : ∀ θ, ∫ ω, U ω ∂P θ = τ θ) (hVmean : ∀ θ, ∫ ω, V ω ∂P θ = τ θ)
    (hV2 : ∀ θ, MemLp V 2 (P θ)) (hV : HasCommonCondExp P m V) (θ : Θ) :
    Var[U; P θ] ≤ Var[V; P θ] := by
  rw [variance_congr (ae_eq_condExp_of_isCompleteSubalgebra hm hc hU hUi hUmean hVmean hV θ)]
  exact variance_condExp_le hm (hV2 θ)

/-- Uniqueness part of Lehmann–Scheffé: under completeness there is at most one `m`-measurable
unbiased estimator of `τ`, up to almost sure equality under every member of the family. -/
theorem ae_eq_of_unbiased_of_isCompleteSubalgebra (hc : IsCompleteSubalgebra P m)
    {U U' : Ω → ℝ} {τ : Θ → ℝ}
    (hU : StronglyMeasurable[m] U) (hU' : StronglyMeasurable[m] U')
    (hUi : ∀ θ, Integrable U (P θ)) (hU'i : ∀ θ, Integrable U' (P θ))
    (hUmean : ∀ θ, ∫ ω, U ω ∂P θ = τ θ) (hU'mean : ∀ θ, ∫ ω, U' ω ∂P θ = τ θ) (θ : Θ) :
    U =ᵐ[P θ] U' :=
  ae_eq_of_isCompleteSubalgebra hc hU hU' hUi hU'i (fun θ => by rw [hUmean θ, hU'mean θ]) θ

end Applied.Statistics
