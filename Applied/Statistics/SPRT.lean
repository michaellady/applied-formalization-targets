import Applied.Statistics.Ville
import Mathlib.Probability.ConditionalExpectation
import Mathlib.Probability.Independence.Integration

/-!
# Wald's sequential probability ratio test: the type-I error bound

Observations `X 0, X 1, …` are independent, each with density `p₀` with respect to a reference
measure `ν` under the null. The likelihood ratio after `n` observations is
`Λ n = ∏ i < n, p₁ (X i) / p₀ (X i)`. Under the null it is a non-negative supermartingale with
`Λ 0 = 1`, and a martingale with mean one when `p₁` vanishes wherever `p₀` does. By Ville's
inequality the probability that it ever reaches a threshold `A > 0` is at most `1 / A`: this
bounds the type-I error of the sequential probability ratio test with upper threshold `A`.

## Conventions

* The filtration is `pastFiltration Y`, whose `n`-th σ-algebra is generated by `Y 0, …, Y (n-1)`
  (what is known *before* observation `n`), so that the empty product `Λ 0 = 1` is adapted.
* Densities are real-valued functions `p₀ p₁ : E → ℝ`, non-negative everywhere, and the null law
  of each observation is `ν.withDensity (ENNReal.ofReal ∘ p₀)`. The ratio `p₁ x / p₀ x` is real
  division, so it is `0` where `p₀ x = 0`.
* The observations are independent and each has the null law; the alternative density `p₁` only
  needs `∫ p₁ ∂ν ≤ 1` for the supermartingale statements.

## Main results

* `supermartingale_partialProd`, `martingale_partialProd`: partial products of independent
  non-negative integrable variables with means at most one (equal to one) form a
  supermartingale (a martingale).
* `integral_likelihoodRatio_le_one`, `integral_likelihoodRatio_eq_one`: the mean of one
  likelihood-ratio factor under the null.
* `supermartingale_likelihoodRatioProcess`, `martingale_likelihoodRatioProcess`.
* `sprt_typeI_error_le`: `P₀ (∃ n, A ≤ Λ n) ≤ 1 / A`.
* `sprt_typeI_error_randomTime_le`: `P₀ (A ≤ Λ τ) ≤ 1 / A` for any random time `τ`.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal

namespace Applied.Sequential

section Product

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- The filtration of the strict past of a sequence: the `n`-th σ-algebra is generated by
`Y 0, …, Y (n - 1)`. -/
def pastFiltration {β : Type*} [MeasurableSpace β] (Y : ℕ → Ω → β)
    (hY : ∀ i, Measurable (Y i)) : Filtration ℕ m0 where
  seq n := ⨆ j ∈ Set.Iio n, MeasurableSpace.comap (Y j) inferInstance
  mono' _ _ hij := biSup_mono fun _ hj => lt_of_lt_of_le hj hij
  le' _ := iSup₂_le fun j _ => (hY j).comap_le

/-- The partial products `∏ i < n, Y i`. -/
def partialProd (Y : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ := ∏ i ∈ Finset.range n, Y i ω

@[simp] lemma partialProd_zero (Y : ℕ → Ω → ℝ) (ω : Ω) : partialProd Y 0 ω = 1 := by
  simp [partialProd]

lemma partialProd_succ (Y : ℕ → Ω → ℝ) (n : ℕ) :
    partialProd Y (n + 1) = partialProd Y n * Y n := by
  ext ω; simp [partialProd, Finset.prod_range_succ]

lemma partialProd_nonneg {Y : ℕ → Ω → ℝ} (hnn : ∀ i ω, 0 ≤ Y i ω) (n : ℕ) (ω : Ω) :
    0 ≤ partialProd Y n ω :=
  Finset.prod_nonneg fun i _ => hnn i ω

variable {Y : ℕ → Ω → ℝ}

lemma stronglyAdapted_partialProd (hY : ∀ i, Measurable (Y i)) :
    StronglyAdapted (pastFiltration (m0 := m0) Y hY) (partialProd Y) := by
  intro n
  refine Measurable.stronglyMeasurable ?_
  unfold partialProd
  refine Finset.measurable_fun_prod _ fun i hi => ?_
  have hle : MeasurableSpace.comap (Y i) inferInstance ≤ pastFiltration (m0 := m0) Y hY n :=
    le_biSup (fun j => MeasurableSpace.comap (Y j) inferInstance)
      (Set.mem_Iio.mpr (Finset.mem_range.mp hi))
  exact (comap_measurable (Y i)).mono hle le_rfl

/-- The strict past of an independent sequence is independent of the present. -/
lemma indep_pastFiltration (hY : ∀ i, Measurable (Y i)) (hindep : iIndepFun Y μ) (n : ℕ) :
    Indep (pastFiltration (m0 := m0) Y hY n) (MeasurableSpace.comap (Y n) inferInstance) μ := by
  have h := indep_iSup_of_disjoint (m := fun j => MeasurableSpace.comap (Y j) inferInstance)
    (fun j => (hY j).comap_le) hindep (S := Set.Iio n) (T := {n}) (by simp)
  simpa [pastFiltration] using h

lemma indepFun_partialProd (hY : ∀ i, Measurable (Y i)) (hindep : iIndepFun Y μ) (n : ℕ) :
    partialProd Y n ⟂ᵢ[μ] Y n := by
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_left (indep_pastFiltration hY hindep n) ?_
  exact ((stronglyAdapted_partialProd (m0 := m0) hY n).measurable).comap_le

lemma integrable_partialProd [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hint : ∀ i, Integrable (Y i) μ) (n : ℕ) :
    Integrable (partialProd Y n) μ := by
  induction n with
  | zero =>
    have h0 : partialProd Y 0 = fun _ => (1 : ℝ) := by ext ω; simp
    rw [h0]; exact integrable_const _
  | succ n ih =>
    rw [partialProd_succ]
    exact (indepFun_partialProd hY hindep n).integrable_mul ih (hint n)

/-- One step of the product process: `E[Λ (n + 1) | past] = E[Y n] * Λ n`. -/
lemma condExp_partialProd_succ [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hint : ∀ i, Integrable (Y i) μ) (n : ℕ) :
    μ[partialProd Y (n + 1) | pastFiltration (m0 := m0) Y hY n] =ᵐ[μ]
      fun ω => partialProd Y n ω * ∫ ω', Y n ω' ∂μ := by
  have h1 : μ[partialProd Y n * Y n | pastFiltration (m0 := m0) Y hY n] =ᵐ[μ]
      partialProd Y n * μ[Y n | pastFiltration (m0 := m0) Y hY n] :=
    condExp_mul_of_stronglyMeasurable_left (stronglyAdapted_partialProd hY n)
      (by rw [← partialProd_succ]; exact integrable_partialProd hY hindep hint (n + 1)) (hint n)
  have h2 : μ[Y n | pastFiltration (m0 := m0) Y hY n] =ᵐ[μ] fun _ => ∫ ω', Y n ω' ∂μ :=
    condExp_indep_eq (hY n).comap_le ((pastFiltration (m0 := m0) Y hY).le n)
      (comap_measurable (Y n)).stronglyMeasurable (indep_pastFiltration hY hindep n).symm
  rw [partialProd_succ]
  filter_upwards [h1, h2] with ω hω1 hω2
  rw [hω1, Pi.mul_apply, hω2]

/-- Partial products of independent non-negative integrable random variables with means at
most one form a supermartingale with respect to the filtration of the strict past. -/
theorem supermartingale_partialProd [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hnn : ∀ i ω, 0 ≤ Y i ω) (hint : ∀ i, Integrable (Y i) μ)
    (hmean : ∀ i, ∫ ω, Y i ω ∂μ ≤ 1) :
    Supermartingale (partialProd Y) (pastFiltration (m0 := m0) Y hY) μ := by
  refine supermartingale_nat (stronglyAdapted_partialProd hY)
    (integrable_partialProd hY hindep hint) fun n => ?_
  filter_upwards [condExp_partialProd_succ hY hindep hint n] with ω hω
  rw [hω]
  exact mul_le_of_le_one_right (partialProd_nonneg hnn n ω) (hmean n)

/-- Partial products of independent integrable random variables with means equal to one form
a martingale with respect to the filtration of the strict past. -/
theorem martingale_partialProd [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hint : ∀ i, Integrable (Y i) μ)
    (hmean : ∀ i, ∫ ω, Y i ω ∂μ = 1) :
    Martingale (partialProd Y) (pastFiltration (m0 := m0) Y hY) μ := by
  refine martingale_nat (stronglyAdapted_partialProd hY)
    (integrable_partialProd hY hindep hint) fun n => ?_
  filter_upwards [condExp_partialProd_succ hY hindep hint n] with ω hω
  rw [hω, hmean n, mul_one]

/-- A martingale started at one has mean one at every time; here for partial products. -/
theorem integral_partialProd_eq_one [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hint : ∀ i, Integrable (Y i) μ)
    (hmean : ∀ i, ∫ ω, Y i ω ∂μ = 1) (n : ℕ) : ∫ ω, partialProd Y n ω ∂μ = 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [partialProd_succ]
    have := (indepFun_partialProd hY hindep n).integral_mul_eq_mul_integral
      (integrable_partialProd hY hindep hint n).aestronglyMeasurable
      (hint n).aestronglyMeasurable
    rw [this, ih, hmean n, mul_one]

/-- **Ville's inequality for a product of independent factors.** If the `Y i` are independent,
non-negative and integrable with means at most one, the probability that some partial product
reaches `A > 0` is at most `1 / A`. -/
theorem measure_exists_partialProd_ge_le [IsProbabilityMeasure μ] (hY : ∀ i, Measurable (Y i))
    (hindep : iIndepFun Y μ) (hnn : ∀ i ω, 0 ≤ Y i ω) (hint : ∀ i, Integrable (Y i) μ)
    (hmean : ∀ i, ∫ ω, Y i ω ∂μ ≤ 1) {A : ℝ} (hA : 0 < A) :
    μ {ω | ∃ n, A ≤ partialProd Y n ω} ≤ ENNReal.ofReal (1 / A) := by
  have h := ville (supermartingale_partialProd hY hindep hnn hint hmean)
    (fun n => ae_of_all _ (partialProd_nonneg hnn n)) (by simp) (one_div_pos.mpr hA)
  simpa using h

end Product

section LikelihoodRatio

variable {Ω E : Type*} {m0 : MeasurableSpace Ω} [MeasurableSpace E] {P : Measure Ω}
  {ν : Measure E} {p₀ p₁ : E → ℝ} {X : ℕ → Ω → E}

/-- The likelihood ratio `p₁ x / p₀ x` of one observation (zero where `p₀ x = 0`). -/
noncomputable def likelihoodRatio (p₀ p₁ : E → ℝ) (x : E) : ℝ := p₁ x / p₀ x

/-- The likelihood-ratio process `Λ n = ∏ i < n, p₁ (X i) / p₀ (X i)`. -/
noncomputable def likelihoodRatioProcess (p₀ p₁ : E → ℝ) (X : ℕ → Ω → E) : ℕ → Ω → ℝ :=
  partialProd fun i ω => likelihoodRatio p₀ p₁ (X i ω)

omit [MeasurableSpace E] in
lemma likelihoodRatioProcess_apply (p₀ p₁ : E → ℝ) (X : ℕ → Ω → E) (n : ℕ) (ω : Ω) :
    likelihoodRatioProcess p₀ p₁ X n ω = ∏ i ∈ Finset.range n, p₁ (X i ω) / p₀ (X i ω) := rfl

omit [MeasurableSpace E] in
lemma likelihoodRatio_nonneg (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (x : E) :
    0 ≤ likelihoodRatio p₀ p₁ x := div_nonneg (hp₁ x) (hp₀ x)

lemma measurable_likelihoodRatio (hm₀ : Measurable p₀) (hm₁ : Measurable p₁) :
    Measurable (likelihoodRatio p₀ p₁) := hm₁.div hm₀

omit [MeasurableSpace E] in
private lemma mul_likelihoodRatio_le (hp₁ : ∀ x, 0 ≤ p₁ x) (x : E) :
    p₀ x * likelihoodRatio p₀ p₁ x ≤ p₁ x := by
  unfold likelihoodRatio
  by_cases h : p₀ x = 0
  · simpa [h] using hp₁ x
  · rw [mul_div_cancel₀ _ h]

/-- The likelihood ratio is integrable under the null law. -/
theorem integrable_likelihoodRatio (hm₀ : Measurable p₀) (hm₁ : Measurable p₁)
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν) :
    Integrable (likelihoodRatio p₀ p₁) (ν.withDensity fun x => ENNReal.ofReal (p₀ x)) := by
  rw [integrable_withDensity_iff_integrable_smul' hm₀.ennreal_ofReal
    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
  refine hint₁.mono' ((hm₀.ennreal_ofReal.ennreal_toReal.smul
    (measurable_likelihoodRatio hm₀ hm₁)).aestronglyMeasurable) (ae_of_all _ fun x => ?_)
  rw [ENNReal.toReal_ofReal (hp₀ x), smul_eq_mul, Real.norm_of_nonneg
    (mul_nonneg (hp₀ x) (likelihoodRatio_nonneg hp₀ hp₁ x))]
  exact mul_likelihoodRatio_le hp₁ x

/-- Under the null law the likelihood ratio has mean at most `∫ p₁ ∂ν`. -/
theorem integral_likelihoodRatio_le (hm₀ : Measurable p₀)
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν) :
    ∫ x, likelihoodRatio p₀ p₁ x ∂(ν.withDensity fun x => ENNReal.ofReal (p₀ x)) ≤
      ∫ x, p₁ x ∂ν := by
  rw [integral_withDensity_eq_integral_toReal_smul hm₀.ennreal_ofReal
    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
  refine integral_mono_of_nonneg (ae_of_all _ fun x => ?_) hint₁ (ae_of_all _ fun x => ?_)
  · show 0 ≤ (ENNReal.ofReal (p₀ x)).toReal • likelihoodRatio p₀ p₁ x
    rw [ENNReal.toReal_ofReal (hp₀ x), smul_eq_mul]
    exact mul_nonneg (hp₀ x) (likelihoodRatio_nonneg hp₀ hp₁ x)
  · simp only [ENNReal.toReal_ofReal (hp₀ x), smul_eq_mul]
    exact mul_likelihoodRatio_le hp₁ x

/-- Under the null law the likelihood ratio has mean exactly `∫ p₁ ∂ν` when `p₁` vanishes
`ν`-almost everywhere on `{p₀ = 0}`. -/
theorem integral_likelihoodRatio_eq (hm₀ : Measurable p₀) (hp₀ : ∀ x, 0 ≤ p₀ x)
    (hac : ∀ᵐ x ∂ν, p₀ x = 0 → p₁ x = 0) :
    ∫ x, likelihoodRatio p₀ p₁ x ∂(ν.withDensity fun x => ENNReal.ofReal (p₀ x)) =
      ∫ x, p₁ x ∂ν := by
  rw [integral_withDensity_eq_integral_toReal_smul hm₀.ennreal_ofReal
    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)]
  refine integral_congr_ae ?_
  filter_upwards [hac] with x hx
  simp only [ENNReal.toReal_ofReal (hp₀ x), smul_eq_mul, likelihoodRatio]
  by_cases h : p₀ x = 0
  · simp [h, hx h]
  · rw [mul_div_cancel₀ _ h]

variable (hm₀ : Measurable p₀) (hm₁ : Measurable p₁) (hX : ∀ i, Measurable (X i))

include hm₀ hm₁ hX in
private lemma measurable_factor (i : ℕ) :
    Measurable fun ω => likelihoodRatio p₀ p₁ (X i ω) :=
  (measurable_likelihoodRatio hm₀ hm₁).comp (hX i)

include hm₀ hm₁ hX in
/-- Each likelihood-ratio factor is integrable under the null. -/
theorem integrable_likelihoodRatio_comp (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x)
    (hint₁ : Integrable p₁ ν)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) (i : ℕ) :
    Integrable (fun ω => likelihoodRatio p₀ p₁ (X i ω)) P := by
  have h := integrable_likelihoodRatio hm₀ hm₁ hp₀ hp₁ hint₁
  rw [← hlaw i] at h
  exact h.comp_measurable (hX i)

include hm₀ hm₁ hX in
/-- Each likelihood-ratio factor has mean at most one under the null when `∫ p₁ ∂ν ≤ 1`. -/
theorem integral_likelihoodRatio_le_one (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x)
    (hint₁ : Integrable p₁ ν) (hmass : ∫ x, p₁ x ∂ν ≤ 1)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) (i : ℕ) :
    ∫ ω, likelihoodRatio p₀ p₁ (X i ω) ∂P ≤ 1 := by
  rw [← integral_map (hX i).aemeasurable
    (measurable_likelihoodRatio hm₀ hm₁).aestronglyMeasurable, hlaw i]
  exact (integral_likelihoodRatio_le hm₀ hp₀ hp₁ hint₁).trans hmass

include hm₀ hm₁ hX in
/-- Each likelihood-ratio factor has mean exactly one under the null when `p₁` is a
probability density that vanishes almost everywhere on `{p₀ = 0}`. -/
theorem integral_likelihoodRatio_eq_one (hp₀ : ∀ x, 0 ≤ p₀ x)
    (hmass : ∫ x, p₁ x ∂ν = 1) (hac : ∀ᵐ x ∂ν, p₀ x = 0 → p₁ x = 0)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) (i : ℕ) :
    ∫ ω, likelihoodRatio p₀ p₁ (X i ω) ∂P = 1 := by
  rw [← integral_map (hX i).aemeasurable
    (measurable_likelihoodRatio hm₀ hm₁).aestronglyMeasurable, hlaw i,
    integral_likelihoodRatio_eq hm₀ hp₀ hac, hmass]

include hm₀ hm₁ in
private lemma iIndepFun_factor (hindep : iIndepFun X P) :
    iIndepFun (fun i ω => likelihoodRatio p₀ p₁ (X i ω)) P :=
  hindep.comp (fun _ => likelihoodRatio p₀ p₁) fun _ => measurable_likelihoodRatio hm₀ hm₁

/-- **The likelihood ratio is a supermartingale under the null.** Independent observations,
each with density `p₀` with respect to `ν`; `p₀, p₁` measurable and non-negative; `p₁`
integrable with `∫ p₁ ∂ν ≤ 1`. The filtration is that of the strict past of the
likelihood-ratio factors. -/
theorem supermartingale_likelihoodRatioProcess [IsProbabilityMeasure P]
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν)
    (hmass : ∫ x, p₁ x ∂ν ≤ 1) (hindep : iIndepFun X P)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) :
    Supermartingale (likelihoodRatioProcess p₀ p₁ X)
      (pastFiltration (m0 := m0) (fun i ω => likelihoodRatio p₀ p₁ (X i ω))
        (measurable_factor hm₀ hm₁ hX)) P :=
  supermartingale_partialProd (measurable_factor hm₀ hm₁ hX)
    (iIndepFun_factor hm₀ hm₁ hindep) (fun i ω => likelihoodRatio_nonneg hp₀ hp₁ (X i ω))
    (integrable_likelihoodRatio_comp hm₀ hm₁ hX hp₀ hp₁ hint₁ hlaw)
    (integral_likelihoodRatio_le_one hm₀ hm₁ hX hp₀ hp₁ hint₁ hmass hlaw)

/-- **The likelihood ratio is a martingale under the null**, when in addition `∫ p₁ ∂ν = 1`
and `p₁` vanishes `ν`-almost everywhere on `{p₀ = 0}`. -/
theorem martingale_likelihoodRatioProcess [IsProbabilityMeasure P]
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν)
    (hmass : ∫ x, p₁ x ∂ν = 1) (hac : ∀ᵐ x ∂ν, p₀ x = 0 → p₁ x = 0) (hindep : iIndepFun X P)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) :
    Martingale (likelihoodRatioProcess p₀ p₁ X)
      (pastFiltration (m0 := m0) (fun i ω => likelihoodRatio p₀ p₁ (X i ω))
        (measurable_factor hm₀ hm₁ hX)) P :=
  martingale_partialProd (measurable_factor hm₀ hm₁ hX)
    (iIndepFun_factor hm₀ hm₁ hindep)
    (integrable_likelihoodRatio_comp hm₀ hm₁ hX hp₀ hp₁ hint₁ hlaw)
    (integral_likelihoodRatio_eq_one hm₀ hm₁ hX hp₀ hmass hac hlaw)

include hm₀ hm₁ hX in
/-- Under the same hypotheses the likelihood ratio has mean one at every time. -/
theorem integral_likelihoodRatioProcess_eq_one [IsProbabilityMeasure P]
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν)
    (hmass : ∫ x, p₁ x ∂ν = 1) (hac : ∀ᵐ x ∂ν, p₀ x = 0 → p₁ x = 0) (hindep : iIndepFun X P)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x)) (n : ℕ) :
    ∫ ω, likelihoodRatioProcess p₀ p₁ X n ω ∂P = 1 :=
  integral_partialProd_eq_one (measurable_factor hm₀ hm₁ hX)
    (iIndepFun_factor hm₀ hm₁ hindep)
    (integrable_likelihoodRatio_comp hm₀ hm₁ hX hp₀ hp₁ hint₁ hlaw)
    (integral_likelihoodRatio_eq_one hm₀ hm₁ hX hp₀ hmass hac hlaw) n

include hm₀ hm₁ hX in
/-- **Type-I error of the sequential probability ratio test.** Under the null (independent
observations each with density `p₀` with respect to `ν`), the probability that the likelihood
ratio ever reaches the threshold `A > 0` is at most `1 / A`. -/
theorem sprt_typeI_error_le [IsProbabilityMeasure P]
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν)
    (hmass : ∫ x, p₁ x ∂ν ≤ 1) (hindep : iIndepFun X P)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    {A : ℝ} (hA : 0 < A) :
    P {ω | ∃ n, A ≤ likelihoodRatioProcess p₀ p₁ X n ω} ≤ ENNReal.ofReal (1 / A) :=
  measure_exists_partialProd_ge_le (measurable_factor hm₀ hm₁ hX)
    (iIndepFun_factor hm₀ hm₁ hindep) (fun i ω => likelihoodRatio_nonneg hp₀ hp₁ (X i ω))
    (integrable_likelihoodRatio_comp hm₀ hm₁ hX hp₀ hp₁ hint₁ hlaw)
    (integral_likelihoodRatio_le_one hm₀ hm₁ hX hp₀ hp₁ hint₁ hmass hlaw) hA

include hm₀ hm₁ hX in
/-- The same bound for the test that looks at the likelihood ratio at an arbitrary random time
`τ` (for instance the time at which the ratio first leaves an interval `(B, A)`, when that
happens) and rejects when it is at least `A`. -/
theorem sprt_typeI_error_randomTime_le [IsProbabilityMeasure P]
    (hp₀ : ∀ x, 0 ≤ p₀ x) (hp₁ : ∀ x, 0 ≤ p₁ x) (hint₁ : Integrable p₁ ν)
    (hmass : ∫ x, p₁ x ∂ν ≤ 1) (hindep : iIndepFun X P)
    (hlaw : ∀ i, P.map (X i) = ν.withDensity fun x => ENNReal.ofReal (p₀ x))
    {A : ℝ} (hA : 0 < A) (τ : Ω → ℕ) :
    P {ω | A ≤ likelihoodRatioProcess p₀ p₁ X (τ ω) ω} ≤ ENNReal.ofReal (1 / A) := by
  refine (measure_mono fun ω hω => ?_).trans
    (sprt_typeI_error_le hm₀ hm₁ hX hp₀ hp₁ hint₁ hmass hindep hlaw hA)
  exact ⟨τ ω, hω⟩

end LikelihoodRatio

end Applied.Sequential
