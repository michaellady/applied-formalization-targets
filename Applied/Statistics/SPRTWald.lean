import Mathlib.MeasureTheory.Integral.Lebesgue.Basic
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

/-!
# Wald's sharper SPRT error bounds by change of measure

Let `P₀, P₁` be two measures on `Ω`, `F` a sequence of sub-σ-algebras, and `Λ n` a real process.
Assume that `Λ n` is the density of `P₁` with respect to `P₀` on `F n`, in the sense that
`P₁ S = ∫⁻ ω in S, ofReal (Λ n ω) ∂P₀` for every `F n`-measurable set `S`. (For i.i.d.
observations with densities `p₀ > 0`, `p₁` and `F n` generated by the first `n` observations,
`Λ n = ∏ i < n, p₁ (X i) / p₀ (X i)` has this property; that instantiation is proved in
`SPRTWaldIID.lean`, not here.)
Let `τ : Ω → ℕ∞` be a random time with `{τ = n} ∈ F n`.

* `wald_upper`: `A · P₀(τ < ∞, Λ τ ≥ A) ≤ P₁(τ < ∞, Λ τ ≥ A)` for `A ≥ 0`. For the SPRT this is
  Wald's bound `α ≤ (1 - β) / A`.
* `wald_lower`: `P₁(τ < ∞, Λ τ ≤ B) ≤ B · P₀(τ < ∞, Λ τ ≤ B)`, i.e. `β ≤ B (1 - α)`.
* `wald_alpha_le`, `wald_beta_le`: the forms with `α, β` for disjoint rejection / acceptance
  events and probability measures.

No filtration-monotonicity is needed; neither is `F n ≤ m0` beyond what is stated.

## Relation to other files

`SPRT.lean` proves the cruder Ville-type bound `α ≤ 1 / A` by the supermartingale route and
does not need the density hypothesis on every `F n`. `SPRTWaldIID.lean` constructs a
`WaldSetup` for i.i.d. observations with densities, so that the bounds here apply to the
classical SPRT. Not here: that the SPRT stops almost surely, Wald's approximations
`A ≈ (1 - β)/α`, `B ≈ β/(1 - α)` as equalities (they ignore overshoot), expected sample sizes
(Wald's identity), and the Wald–Wolfowitz optimality theorem.
-/

open MeasureTheory
open scoped ENNReal

namespace Applied.Sequential

variable {Ω : Type*} {m0 : MeasurableSpace Ω}

/-- The event `{τ < ∞, p (Λ τ)}`: the random time `τ` is finite and the process stopped at `τ`
satisfies the predicate `p`. It is written as "there is `n` with `τ = n` and `p (Λ n)`", i.e. as a
union over the value of `τ` (see `stoppedEvent_eq_iUnion`). -/
def stoppedEvent (τ : Ω → ℕ∞) (Λ : ℕ → Ω → ℝ) (p : ℝ → Prop) : Set Ω :=
  {ω | ∃ n : ℕ, τ ω = n ∧ p (Λ n ω)}

/-- The piece of `stoppedEvent` where `τ = n`. -/
def stoppedPiece (τ : Ω → ℕ∞) (Λ : ℕ → Ω → ℝ) (p : ℝ → Prop) (n : ℕ) : Set Ω :=
  {ω | τ ω = n} ∩ {ω | p (Λ n ω)}

/-- `{τ < ∞, p (Λ τ)}` is the union over `n` of its pieces `{τ = n, p (Λ n)}`. -/
lemma stoppedEvent_eq_iUnion (τ : Ω → ℕ∞) (Λ : ℕ → Ω → ℝ) (p : ℝ → Prop) :
    stoppedEvent τ Λ p = ⋃ n, stoppedPiece τ Λ p n := by
  ext ω; simp [stoppedEvent, stoppedPiece]

/-- The pieces `{τ = n, p (Λ n)}` for different `n` are disjoint. -/
lemma pairwise_disjoint_stoppedPiece (τ : Ω → ℕ∞) (Λ : ℕ → Ω → ℝ) (p : ℝ → Prop) :
    Pairwise (Function.onFun Disjoint (stoppedPiece τ Λ p)) := by
  intro i j hij
  refine Set.disjoint_left.2 fun ω hi hj => hij ?_
  have h1 := hi.1; have h2 := hj.1
  simp only [Set.mem_ofPred_eq] at h1 h2
  exact_mod_cast h1.symm.trans h2

variable {P₀ P₁ : Measure Ω} {F : ℕ → MeasurableSpace Ω} {Λ : ℕ → Ω → ℝ} {τ : Ω → ℕ∞}

/-- Common setup for Wald's change-of-measure argument. `P₀` (null) and `P₁` (alternative) are
measures on `Ω`, `F n` is the information available at time `n`, `Λ n` is a real process and
`τ` a random time with values in `ℕ ∪ {∞}`. The fields say:

* `le`: each `F n` is a sub-σ-algebra of the ambient σ-algebra;
* `stop`: `τ` is a stopping time in the sense that `{τ = n}` is decided at time `n`;
* `adapted`: `Λ n` is `F n`-measurable;
* `density`: `Λ n` is the likelihood ratio on `F n`, i.e. `P₁ S = ∫_S Λ n dP₀` for every
  `F n`-measurable `S`.

The family `F` need not be increasing. -/
structure WaldSetup (P₀ P₁ : Measure Ω) (F : ℕ → MeasurableSpace Ω) (Λ : ℕ → Ω → ℝ)
    (τ : Ω → ℕ∞) : Prop where
  le : ∀ n, F n ≤ m0
  stop : ∀ n, MeasurableSet[F n] {ω | τ ω = n}
  adapted : ∀ n, Measurable[F n] (Λ n)
  density : ∀ n (S : Set Ω), MeasurableSet[F n] S →
    P₁ S = ∫⁻ ω in S, ENNReal.ofReal (Λ n ω) ∂P₀

/-- The piece `{τ = n, Λ n ∈ s}` is decided by the information available at time `n`. -/
lemma WaldSetup.measurableSet_piece (h : WaldSetup P₀ P₁ F Λ τ) {s : Set ℝ}
    (hs : MeasurableSet s) (n : ℕ) :
    MeasurableSet[F n] (stoppedPiece τ Λ (· ∈ s) n) :=
  (h.stop n).inter (h.adapted n hs)

/-- Decomposition by the stopping time: the probability of `{τ < ∞, Λ τ ∈ s}` is the sum over
`n` of the probabilities of `{τ = n, Λ n ∈ s}` (for any measure on `Ω`). -/
lemma WaldSetup.measure_stoppedEvent (h : WaldSetup P₀ P₁ F Λ τ) (μ : Measure Ω)
    {s : Set ℝ} (hs : MeasurableSet s) :
    μ (stoppedEvent τ Λ (· ∈ s)) = ∑' n, μ (stoppedPiece τ Λ (· ∈ s) n) := by
  rw [stoppedEvent_eq_iUnion]
  exact measure_iUnion (pairwise_disjoint_stoppedPiece _ _ _)
    fun n => h.le n _ (h.measurableSet_piece hs n)

/-- **Wald's upper bound by change of measure.** If `Λ n` is the density of `P₁` with respect to
`P₀` on `F n` and `τ` is a stopping time, then for `A ≥ 0`
`A · P₀(τ < ∞, A ≤ Λ τ) ≤ P₁(τ < ∞, A ≤ Λ τ)`. -/
theorem wald_upper (h : WaldSetup P₀ P₁ F Λ τ) (A : ℝ) :
    ENNReal.ofReal A * P₀ (stoppedEvent τ Λ (· ∈ Set.Ici A)) ≤
      P₁ (stoppedEvent τ Λ (· ∈ Set.Ici A)) := by
  rw [h.measure_stoppedEvent P₀ measurableSet_Ici, h.measure_stoppedEvent P₁ measurableSet_Ici,
    ← ENNReal.tsum_mul_left]
  refine tsum_le_tsum fun n => ?_
  rw [h.density n _ (h.measurableSet_piece measurableSet_Ici n), ← setLIntegral_const]
  refine setLIntegral_mono (Measurable.ennreal_ofReal (mα := m0) ((h.adapted n).mono (h.le n) le_rfl)) ?_
  intro ω hω
  exact ENNReal.ofReal_le_ofReal hω.2

/-- **Wald's lower bound by change of measure.** Under the same hypotheses, for every `B`,
`P₁(τ < ∞, Λ τ ≤ B) ≤ B · P₀(τ < ∞, Λ τ ≤ B)`. -/
theorem wald_lower (h : WaldSetup P₀ P₁ F Λ τ) (B : ℝ) :
    P₁ (stoppedEvent τ Λ (· ∈ Set.Iic B)) ≤
      ENNReal.ofReal B * P₀ (stoppedEvent τ Λ (· ∈ Set.Iic B)) := by
  rw [h.measure_stoppedEvent P₀ measurableSet_Iic, h.measure_stoppedEvent P₁ measurableSet_Iic,
    ← ENNReal.tsum_mul_left]
  refine tsum_le_tsum fun n => ?_
  rw [h.density n _ (h.measurableSet_piece measurableSet_Iic n), ← setLIntegral_const]
  refine setLIntegral_mono measurable_const ?_
  intro ω hω
  exact ENNReal.ofReal_le_ofReal hω.2

/-- **Wald's type-I bound `A α ≤ 1 - β`.** Let `P₁` be a probability measure, and let `Acc` be
any measurable event disjoint from the rejection event `R = {τ < ∞, A ≤ Λ τ}` (for the SPRT,
acceptance of the null). With `α = P₀ R` and `β = P₁ Acc`, `A · α ≤ 1 - β`. -/
theorem wald_alpha_le [IsProbabilityMeasure P₁] (h : WaldSetup P₀ P₁ F Λ τ) (A : ℝ)
    {Acc : Set Ω} (hAcc : MeasurableSet Acc)
    (hdisj : Disjoint Acc (stoppedEvent τ Λ (· ∈ Set.Ici A))) :
    ENNReal.ofReal A * P₀ (stoppedEvent τ Λ (· ∈ Set.Ici A)) ≤ 1 - P₁ Acc := by
  refine (wald_upper h A).trans ?_
  rw [← prob_compl_eq_one_sub hAcc]
  exact measure_mono (hdisj.subset_compl_left)

/-- **Wald's type-II bound `β ≤ B (1 - α)`.** Let `P₀` be a probability measure, and `Rej` any
measurable event disjoint from the acceptance event `{τ < ∞, Λ τ ≤ B}`. With
`β = P₁(τ < ∞, Λ τ ≤ B)` and `α = P₀ Rej`, `β ≤ B · (1 - α)`. -/
theorem wald_beta_le [IsProbabilityMeasure P₀] (h : WaldSetup P₀ P₁ F Λ τ) (B : ℝ)
    {Rej : Set Ω} (hRej : MeasurableSet Rej)
    (hdisj : Disjoint Rej (stoppedEvent τ Λ (· ∈ Set.Iic B))) :
    P₁ (stoppedEvent τ Λ (· ∈ Set.Iic B)) ≤ ENNReal.ofReal B * (1 - P₀ Rej) := by
  refine (wald_lower h B).trans ?_
  rw [← prob_compl_eq_one_sub hRej]
  gcongr
  exact hdisj.subset_compl_left

end Applied.Sequential
