import Applied.Statistics.GroupSequentialCanonical
import Mathlib.MeasureTheory.Measure.Prod
import Mathlib.Probability.CDF

/-!
# The conditional error principle and sample-size increase with the conventional test

A two-stage trial looks at the data once, after the first stage, and may then change the design
of the second stage. The *conditional error principle* (Proschan–Hunsberger 1995,
Müller–Schäfer 2001, 2004) says that the change does not inflate the type I error as long as,
given the interim data, the new test rejects with conditional probability at most that of the
originally planned test.

## Main results

Abstract principle (any measure, set form, no conditional expectations):

* `measure_iUnion_selected_le`: `m1`-measurable selector `D` into a countable type, original
  rejection event `E`, replacement events `E' d`; if `P (B ∩ E' d) ≤ P (B ∩ E)` for every
  `m1`-measurable `B ⊆ {D = d}`, then `P (⋃ d, {D = d} ∩ E' d) ≤ P E`.
* `measure_iUnion_selected_eq`: the same with equalities.

Independence and Fubini:

* `measure_inter_preimage_prodMk_of_indep`: if `X` is `m1`-measurable and `Y` is independent of
  `m1`, then for `B ∈ m1` and measurable `S ⊆ ℝ × ℝ`,
  `P (B ∩ {(X, Y) ∈ S}) = ∫⁻ ω in B, (law of Y) {y | (X ω, y) ∈ S} ∂P`.

Gaussian two-stage model (`ξ i` independent standard normal, first stage `ξ 0, …, ξ (n1 - 1)`,
second stage of size `d` the next `d` observations, `firstStage ξ n1` the σ-algebra generated by
the first stage):

* `measure_inter_reject_eq_lintegral_condError`: the conditional error function of the
  one-sided z-test, `A(z1) = N(0,1) [ (c √(n1+d) - z1 √n1) / √d, ∞ )`, in set form.
* `critValue_le_critValue`, `critValue_lt_critValue`, `critValue_monotoneOn_iff`: the calculus
  fact about `m ↦ (c √(n1+m) - z1 √n1) / √m`.
* `critValue_sub_trend_nonpos_iff`: the zone `z1 ≥ c √(n1 / (n1 + n2))` is "conditional power
  under the current trend at least one half".
* `measure_conventional_adaptive_le`: **sample-size increase with the conventional test when
  conditional power under the current trend is at least 50%** (Chen–DeMets–Lan 2004): type I
  error at most `N(0,1) [c, ∞)`. This is only the upper part of the "promising zone" of
  Mehta–Pocock (2011), whose lower end lies below 50% conditional power and is not treated;
  docstrings below that say "promising zone" mean the region `z1 ≥ c √(n1 / (n1 + n2))`.
* `measure_weighted_adaptive_eq`: the test with the pre-planned weights (Cui–Hung–Wang 1999,
  Lehmacher–Wassmer 1999) has type I error exactly `N(0,1) [c, ∞)` for every first-stage
  measurable second-stage size.

## Relation to other files and scope

Uses the partial sums and z-statistics of `GroupSequentialCanonical.lean`. The p-value based
route to adaptive designs is in `CombinationTests.lean` (Fisher's product, general conditional
error functions of the first-stage p-value) and `InverseNormalCombination.lean` (weighted
z-statistic); `measure_weighted_adaptive_eq` here is the model-based counterpart of the latter.
Not here: unknown variance, early stopping at the interim, sample-size decreases, the
Mehta–Pocock zone below 50% conditional power, any statement that the level is inflated when
the sample size is increased outside the region (only the critical value is shown to drop),
non-null drift (power), and the Müller–Schäfer principle phrased with conditional expectations of test
functions.
-/

open MeasureTheory ProbabilityTheory Finset Set
open scoped ENNReal NNReal

namespace Applied.ConditionalError

open Applied.GroupSequential

section Principle

variable {Ω ι : Type*} [Countable ι] {m1 mΩ : MeasurableSpace Ω} {P : Measure Ω} {D : Ω → ι}

omit [Countable ι] in
/-- The fibres of an `m1`-measurable selector partition any event. -/
lemma tsum_measure_fiber_inter [Countable ι] (hm : m1 ≤ mΩ)
    (hD : ∀ d, MeasurableSet[m1] (D ⁻¹' {d})) (E : Set Ω) :
    ∑' d, P (D ⁻¹' {d} ∩ E) = P E := by
  have h1 : ∀ d, P (D ⁻¹' {d} ∩ E) = P.restrict E (D ⁻¹' {d}) := fun d =>
    (Measure.restrict_apply (hm _ (hD d))).symm
  simp_rw [h1]
  rw [← measure_iUnion (fun i j hij => by
    refine Set.disjoint_left.mpr fun ω hi hj => hij ?_
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hi hj
    rw [← hi, ← hj]) (fun d => hm _ (hD d))]
  have : ⋃ d, D ⁻¹' {d} = Set.univ := by
    ext ω; simp
  rw [this, Measure.restrict_apply_univ]

/-- **Conditional error principle, set form.** Let `m1 ≤ mΩ` be the interim information, `D` an
`m1`-measurable choice among countably many designs, `E` the rejection event of the original
test and `E' d` that of the replacement test of design `d`. If on every `m1`-measurable part
`B` of `{D = d}` the replacement rejects with probability at most that of the original test,
then the adaptive test, which uses the replacement test of the chosen design, rejects with
probability at most `P E`. No measurability of `E` or `E' d` is needed. -/
theorem measure_iUnion_selected_le (hm : m1 ≤ mΩ) (hD : ∀ d, MeasurableSet[m1] (D ⁻¹' {d}))
    {E : Set Ω} {E' : ι → Set Ω}
    (h : ∀ d, ∀ B, MeasurableSet[m1] B → B ⊆ D ⁻¹' {d} → P (B ∩ E' d) ≤ P (B ∩ E)) :
    P (⋃ d, D ⁻¹' {d} ∩ E' d) ≤ P E :=
  calc P (⋃ d, D ⁻¹' {d} ∩ E' d) ≤ ∑' d, P (D ⁻¹' {d} ∩ E' d) := measure_iUnion_le _
    _ ≤ ∑' d, P (D ⁻¹' {d} ∩ E) := tsum_le_tsum fun d => h d _ (hD d) subset_rfl
    _ = P E := tsum_measure_fiber_inter hm hD E

/-- **Conditional error principle with equality.** If the replacement tests have exactly the
conditional error of the original test (on `{D = d}`), the adaptive test has exactly the
original level. The replacement events are assumed measurable. -/
theorem measure_iUnion_selected_eq (hm : m1 ≤ mΩ) (hD : ∀ d, MeasurableSet[m1] (D ⁻¹' {d}))
    {E : Set Ω} {E' : ι → Set Ω} (hE' : ∀ d, MeasurableSet (E' d))
    (h : ∀ d, P (D ⁻¹' {d} ∩ E' d) = P (D ⁻¹' {d} ∩ E)) :
    P (⋃ d, D ⁻¹' {d} ∩ E' d) = P E := by
  rw [measure_iUnion (fun i j hij => by
    refine Set.disjoint_left.mpr fun ω hi hj => hij ?_
    have hi' := hi.1
    have hj' := hj.1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hi' hj'
    rw [← hi', ← hj']) (fun d => (hm _ (hD d)).inter (hE' d))]
  simp_rw [h]
  exact tsum_measure_fiber_inter hm hD E

end Principle

section Fubini

variable {Ω : Type*} {m1 mΩ : MeasurableSpace Ω} {P : Measure Ω}

/-- **Independence as a Fubini formula.** Let `X` be measurable with respect to a sub-σ-algebra
`m1` and let `Y` be independent of `m1`. Then for `B ∈ m1` and a measurable `S ⊆ ℝ × ℝ`,
`P (B ∩ {(X, Y) ∈ S}) = ∫⁻ ω in B, (P.map Y) {y | (X ω, y) ∈ S} ∂P`: the function
`ω ↦ (P.map Y) {y | (X ω, y) ∈ S}` is a version of the conditional probability of
`{(X, Y) ∈ S}` given `m1`. -/
theorem measure_inter_preimage_prodMk_of_indep [IsFiniteMeasure P]
    (hm : m1 ≤ mΩ) {X Y : Ω → ℝ} (hX : Measurable[m1] X) (hY : Measurable[mΩ] Y)
    (hind : Indep m1 (MeasurableSpace.comap Y inferInstance) P) {B : Set Ω}
    (hB : MeasurableSet[m1] B) {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) :
    P (B ∩ (fun ω => (X ω, Y ω)) ⁻¹' S) = ∫⁻ ω in B, (P.map Y) (Prod.mk (X ω) ⁻¹' S) ∂P := by
  have hXm : Measurable[mΩ] X := hX.mono hm le_rfl
  have hXY : Measurable[mΩ] fun ω => (X ω, Y ω) := hXm.prodMk hY
  have key : ((P.restrict B).map X).prod (P.map Y) =
      (P.restrict B).map (fun ω => (X ω, Y ω)) := by
    refine Measure.prod_eq fun s t hs ht => ?_
    rw [Measure.map_apply hXY (hs.prod ht), Measure.restrict_apply (hXY (hs.prod ht)),
      Measure.map_apply hXm hs, Measure.restrict_apply (hXm hs), Measure.map_apply hY ht]
    have h := (Indep_iff _ _ _).mp hind (X ⁻¹' s ∩ B) (Y ⁻¹' t) ((hX hs).inter hB) ⟨t, ht, rfl⟩
    rw [← h]
    congr 1
    ext ω
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_prod]
    tauto
  rw [Set.inter_comm, ← Measure.restrict_apply (hXY hS), ← Measure.map_apply hXY hS, ← key,
    Measure.prod_apply hS, lintegral_map (measurable_measure_prodMk_left hS) hXm]

end Fubini

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}

section Calculus

/-- The second-stage critical value of the conventional test on the z-scale: with first-stage
size `n1`, first-stage z-statistic `z`, final critical value `c` and second-stage size `m`,
the final statistic `(√n1 z + √m z2) / √(n1 + m)` is at least `c` exactly when the second-stage
z-statistic `z2` is at least `critValue n1 c z m = (c √(n1 + m) - z √n1) / √m`. -/
noncomputable def critValue (n1 : ℕ) (c z m : ℝ) : ℝ :=
  (c * √((n1 : ℝ) + m) - z * √(n1 : ℝ)) / √m

/-- The key identity behind the monotonicity lemma. -/
lemma critValue_sub (n1 : ℕ) (c z : ℝ) {n2 m : ℝ} (hn2 : 0 < n2) (hm : 0 < m) :
    critValue n1 c z m - critValue n1 c z n2 =
      (√m - √n2) / (√m * √n2) *
        (z * √(n1 : ℝ) - c * n1 * (√m + √n2) / (√n2 * √(n1 + m) + √m * √(n1 + n2))) := by
  have hn1 : (0 : ℝ) ≤ n1 := Nat.cast_nonneg n1
  have h1 : 0 < √m := Real.sqrt_pos.mpr hm
  have h2 : 0 < √n2 := Real.sqrt_pos.mpr hn2
  have h3 : 0 < √(n1 + m) := Real.sqrt_pos.mpr (by positivity)
  have h4 : 0 < √(n1 + n2) := Real.sqrt_pos.mpr (by positivity)
  have e1 : √m ^ 2 = m := Real.sq_sqrt hm.le
  have e2 : √n2 ^ 2 = n2 := Real.sq_sqrt hn2.le
  have e3 : √(n1 + m) ^ 2 = n1 + m := Real.sq_sqrt (by positivity)
  have e4 : √(n1 + n2) ^ 2 = n1 + n2 := Real.sq_sqrt (by positivity)
  have hden : 0 < √n2 * √(n1 + m) + √m * √(n1 + n2) := by positivity
  have hK : c * n1 * (√m + √n2) / (√n2 * √(n1 + m) + √m * √(n1 + n2)) * (√m - √n2) =
      c * (√m * √(n1 + n2) - √n2 * √(n1 + m)) := by
    rw [div_mul_eq_mul_div, div_eq_iff hden.ne']
    linear_combination (-c * √m ^ 2) * e4 + (c * √n2 ^ 2) * e3 - c * n2 * e1 + c * m * e2
  have hsplit : (√m - √n2) / (√m * √n2) *
        (z * √(n1 : ℝ) - c * n1 * (√m + √n2) / (√n2 * √(n1 + m) + √m * √(n1 + n2))) =
      ((√m - √n2) * (z * √(n1 : ℝ)) -
        c * n1 * (√m + √n2) / (√n2 * √(n1 + m) + √m * √(n1 + n2)) * (√m - √n2)) /
          (√m * √n2) := by ring
  rw [hsplit, hK]
  unfold critValue
  field_simp
  ring

/-- **Monotonicity in the zone `z ≥ c √(n1 / (n1 + n2))` (conditional power under the current
trend at least 50%; called the promising zone in this file).** For `c ≥ 0`, real second-stage sizes
`0 < n2 ≤ m` and a first-stage z-statistic `z ≥ c √(n1 / (n1 + n2))`, increasing the
second-stage size from `n2` to `m` does not lower the second-stage critical value. -/
theorem critValue_le_critValue (n1 : ℕ) {c z n2 m : ℝ} (hc : 0 ≤ c) (hn2 : 0 < n2)
    (hnm : n2 ≤ m) (hz : c * √((n1 : ℝ) / (n1 + n2)) ≤ z) :
    critValue n1 c z n2 ≤ critValue n1 c z m := by
  have hm : 0 < m := hn2.trans_le hnm
  have hn1 : (0 : ℝ) ≤ n1 := Nat.cast_nonneg n1
  have h1 : 0 < √m := Real.sqrt_pos.mpr hm
  have h2 : 0 < √n2 := Real.sqrt_pos.mpr hn2
  have h3 : 0 < √(n1 + m) := Real.sqrt_pos.mpr (by positivity)
  have h4 : 0 < √(n1 + n2) := Real.sqrt_pos.mpr (by positivity)
  have hs : √n2 ≤ √m := Real.sqrt_le_sqrt hnm
  have hs' : √(n1 + n2) ≤ √(n1 + m) := Real.sqrt_le_sqrt (by linarith)
  rw [← sub_nonneg, critValue_sub n1 c z hn2 hm]
  refine mul_nonneg (div_nonneg (sub_nonneg.mpr hs) (by positivity)) (sub_nonneg.mpr ?_)
  have hz' : c * (√(n1 : ℝ) / √(n1 + n2)) * √(n1 : ℝ) ≤ z * √(n1 : ℝ) := by
    rw [← Real.sqrt_div hn1]
    exact mul_le_mul_of_nonneg_right hz (Real.sqrt_nonneg _)
  refine le_trans ?_ hz'
  have e : c * (√(n1 : ℝ) / √(n1 + n2)) * √(n1 : ℝ) = c * n1 * (1 / √(n1 + n2)) := by
    have : √(n1 : ℝ) * √(n1 : ℝ) = n1 := Real.mul_self_sqrt hn1
    field_simp
    linear_combination c * this
  rw [e, mul_div_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [div_le_div_iff₀ (by positivity) h4]
  nlinarith [mul_le_mul hs hs' h4.le h1.le, mul_pos h2 h4, mul_pos h1 h4]

/-- **Outside the zone `z ≥ c √(n1 / (n1 + n2))` the critical value drops** (this does not by
itself show that the type I error is inflated). For `c ≥ 0`, real sizes
`0 < n2 < m` and `z < c √(n1 / (n1 + m))`, the second-stage critical value at `m` is strictly
below the one at `n2`. -/
theorem critValue_lt_critValue {n1 : ℕ} (hn1' : 0 < n1) {c z n2 m : ℝ} (hc : 0 ≤ c) (hn2 : 0 < n2)
    (hnm : n2 < m) (hz : z < c * √((n1 : ℝ) / (n1 + m))) :
    critValue n1 c z m < critValue n1 c z n2 := by
  have hm : 0 < m := hn2.trans hnm
  have hn1 : (0 : ℝ) ≤ n1 := Nat.cast_nonneg n1
  have h1 : 0 < √m := Real.sqrt_pos.mpr hm
  have h2 : 0 < √n2 := Real.sqrt_pos.mpr hn2
  have h3 : 0 < √(n1 + m) := Real.sqrt_pos.mpr (by positivity)
  have h4 : 0 < √(n1 + n2) := Real.sqrt_pos.mpr (by positivity)
  have hs : √n2 < √m := Real.sqrt_lt_sqrt hn2.le hnm
  have hs' : √(n1 + n2) ≤ √(n1 + m) := Real.sqrt_le_sqrt (by linarith)
  have hn1pos : 0 < √(n1 : ℝ) := Real.sqrt_pos.mpr (by exact_mod_cast hn1')
  rw [← sub_neg, critValue_sub n1 c z hn2 hm]
  refine mul_neg_of_pos_of_neg (div_pos (sub_pos.mpr hs) (by positivity)) (sub_neg.mpr ?_)
  have hz' : z * √(n1 : ℝ) < c * (√(n1 : ℝ) / √(n1 + m)) * √(n1 : ℝ) := by
    rw [← Real.sqrt_div hn1]
    exact mul_lt_mul_of_pos_right hz hn1pos
  refine lt_of_lt_of_le hz' ?_
  have e : c * (√(n1 : ℝ) / √(n1 + m)) * √(n1 : ℝ) = c * n1 * (1 / √(n1 + m)) := by
    have : √(n1 : ℝ) * √(n1 : ℝ) = n1 := Real.mul_self_sqrt hn1
    field_simp
    linear_combination c * this
  rw [e, mul_div_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [div_le_div_iff₀ h3 (by positivity)]
  nlinarith [mul_le_mul hs.le hs' h4.le h1.le, mul_pos h2 h3, mul_pos h1 h3]

/-- **The calculus fact.** For `n1 > 0`, `c ≥ 0` and `n2 > 0`, the second-stage critical value
`m ↦ (c √(n1 + m) - z √n1) / √m` is nondecreasing on `[n2, ∞)` exactly when
`z ≥ c √(n1 / (n1 + n2))`. -/
theorem critValue_monotoneOn_iff {n1 : ℕ} (hn1 : 0 < n1) {c z n2 : ℝ} (hc : 0 ≤ c)
    (hn2 : 0 < n2) :
    MonotoneOn (critValue n1 c z) (Set.Ici n2) ↔ c * √((n1 : ℝ) / (n1 + n2)) ≤ z := by
  have hn1r : (0 : ℝ) < n1 := by exact_mod_cast hn1
  constructor
  · intro hmono
    by_contra hcon
    rw [not_le] at hcon
    have hcont : ContinuousAt (fun m : ℝ => c * √((n1 : ℝ) / (n1 + m))) n2 := by
      have hne : (n1 : ℝ) + n2 ≠ 0 := by positivity
      fun_prop (disch := exact hne)
    obtain ⟨m, hm, hzm⟩ := (hcont.eventually (lt_mem_nhds hcon)).exists_gt
    exact absurd (hmono (Set.mem_Ici.mpr le_rfl) (Set.mem_Ici.mpr hm.le) hm.le)
      (not_le.mpr (critValue_lt_critValue hn1 hc hn2 hm hzm))
  · intro hz a ha b _ hab
    rw [Set.mem_Ici] at ha
    refine critValue_le_critValue n1 hc (hn2.trans_le ha) hab (le_trans ?_ hz)
    refine mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt ?_) hc
    exact div_le_div_of_nonneg_left hn1r.le (by positivity) (by linarith)

/-- **The zone `z ≥ c √(n1 / (n1 + n2))` is "conditional power under the current trend at least
one half"** (the Chen–DeMets–Lan condition; the Mehta–Pocock promising zone extends lower).
Under the drift estimated at the interim, `z / √n1` per observation, the second-stage z-statistic
of `n2` observations has mean `(z / √n1) √n2`, so the conditional power is
`1 - Φ(critValue n1 c z n2 - (z / √n1) √n2)`. It is at least one half exactly when the argument
is nonpositive, and that is the condition `z ≥ c √(n1 / (n1 + n2))`. -/
theorem critValue_sub_trend_nonpos_iff {n1 : ℕ} (hn1 : 0 < n1) (c z : ℝ) {n2 : ℝ}
    (hn2 : 0 < n2) :
    critValue n1 c z n2 - z / √(n1 : ℝ) * √n2 ≤ 0 ↔ c * √((n1 : ℝ) / (n1 + n2)) ≤ z := by
  have hn1r : (0 : ℝ) < n1 := by exact_mod_cast hn1
  have ha : 0 < √(n1 : ℝ) := Real.sqrt_pos.mpr hn1r
  have hb : 0 < √n2 := Real.sqrt_pos.mpr hn2
  have hs : 0 < √((n1 : ℝ) + n2) := Real.sqrt_pos.mpr (by positivity)
  have ea : √(n1 : ℝ) ^ 2 = n1 := Real.sq_sqrt hn1r.le
  have eb : √n2 ^ 2 = n2 := Real.sq_sqrt hn2.le
  have es : √((n1 : ℝ) + n2) ^ 2 = √(n1 : ℝ) ^ 2 + √n2 ^ 2 := by
    rw [ea, eb, Real.sq_sqrt (by positivity)]
  rw [Real.sqrt_div hn1r.le, ← mul_div_assoc, div_le_iff₀ hs]
  unfold critValue
  generalize √(n1 : ℝ) = a at *
  generalize √((n1 : ℝ) + n2) = s at *
  generalize √n2 = b at *
  have key : (c * s - z * a) / b - z / a * b = s / (a * b) * (c * a - z * s) := by
    field_simp
    linear_combination z * es
  have hpos : 0 < s / (a * b) := by positivity
  rw [key]
  constructor
  · intro h
    have := le_of_mul_le_mul_left (by simpa using h : s / (a * b) * (c * a - z * s) ≤
      s / (a * b) * 0) hpos
    linarith
  · intro h
    exact mul_nonpos_of_nonneg_of_nonpos hpos.le (by linarith)

end Calculus

section Gaussian

variable {ξ : ℕ → Ω → ℝ}

/-- The σ-algebra generated by the first `n` observations: the interim information after a
first stage of size `n`. -/
@[instance_reducible]
def firstStage (ξ : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ {i : ℕ | i < n}, MeasurableSpace.comap (ξ i) inferInstance

/-- The σ-algebra generated by the observations from index `n` on. -/
@[instance_reducible]
def laterStages (ξ : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ {i : ℕ | n ≤ i}, MeasurableSpace.comap (ξ i) inferInstance

/-- The interim information is a sub-σ-algebra of the ambient one. -/
lemma firstStage_le (hξ : ∀ i, Measurable (ξ i)) (n : ℕ) : firstStage ξ n ≤ mΩ :=
  iSup₂_le fun i _ => (hξ i).comap_le

/-- The first-stage sum `S n` is known at the interim: it is `firstStage ξ n`-measurable. -/
lemma measurable_firstStage_partialSum (ξ : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[firstStage ξ n] (partialSum ξ n) :=
  Finset.measurable_fun_sum _ fun i hi =>
    (comap_measurable (ξ i)).mono
      (le_biSup (fun j => MeasurableSpace.comap (ξ j) inferInstance)
        (show i ∈ {i : ℕ | i < n} from Finset.mem_range.mp hi)) le_rfl

/-- The first-stage z-statistic `Z n = S n / √n` is known at the interim. -/
lemma measurable_firstStage_zStat (ξ : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[firstStage ξ n] (zStat ξ n) :=
  (measurable_firstStage_partialSum ξ n).div_const _

/-- The sum of the `d` second-stage observations `ξ n1, …, ξ (n1 + d - 1)`. -/
def stageTwoSum (ξ : ℕ → Ω → ℝ) (n1 d : ℕ) (ω : Ω) : ℝ :=
  partialSum ξ (n1 + d) ω - partialSum ξ n1 ω

/-- The second-stage sum is measurable. -/
lemma measurable_stageTwoSum (hξ : ∀ i, Measurable (ξ i)) (n1 d : ℕ) :
    Measurable (stageTwoSum ξ n1 d) :=
  (measurable_partialSum hξ _).sub (measurable_partialSum hξ _)

/-- The second-stage sum depends only on the observations after the first stage. -/
lemma measurable_laterStages_stageTwoSum (ξ : ℕ → Ω → ℝ) (n1 d : ℕ) :
    Measurable[laterStages ξ n1] (stageTwoSum ξ n1 d) := by
  have h : stageTwoSum ξ n1 d = fun ω => ∑ i ∈ Finset.Ico n1 (n1 + d), ξ i ω := by
    ext ω
    exact partialSum_sub ξ (Nat.le_add_right n1 d) ω
  rw [h]
  exact Finset.measurable_fun_sum _ fun i hi =>
    (comap_measurable (ξ i)).mono
      (le_biSup (fun j => MeasurableSpace.comap (ξ j) inferInstance)
        (show i ∈ {i : ℕ | n1 ≤ i} from (Finset.mem_Ico.mp hi).1)) le_rfl

/-- The first stage is independent of all later observations. -/
theorem indep_firstStage_laterStages (hξ : ∀ i, Measurable (ξ i)) (hindep : iIndepFun ξ P)
    (n : ℕ) : Indep (firstStage ξ n) (laterStages ξ n) P := by
  have h := iIndep_biSup_of_pairwise_disjoint (μ := P)
    (m := fun i => MeasurableSpace.comap (ξ i) inferInstance) (fun i => (hξ i).comap_le) hindep
    (S := fun b : Bool => if b then {i : ℕ | i < n} else {i : ℕ | n ≤ i}) (by
      intro a b hab
      cases a <;> cases b <;> simp_all [Function.onFun, Set.disjoint_left])
  have h2 := h.indep (i := true) (j := false) (by simp)
  simpa [firstStage, laterStages] using h2

/-- The second-stage sum is independent of the first stage. -/
theorem indep_firstStage_stageTwoSum (hξ : ∀ i, Measurable (ξ i)) (hindep : iIndepFun ξ P)
    (n1 d : ℕ) :
    Indep (firstStage ξ n1) (MeasurableSpace.comap (stageTwoSum ξ n1 d) inferInstance) P :=
  indep_of_indep_of_le_right (indep_firstStage_laterStages hξ hindep n1)
    (measurable_laterStages_stageTwoSum ξ n1 d).comap_le

/-- The second-stage sum of `d` observations has law `N(0, d)`. -/
theorem map_stageTwoSum [IsProbabilityMeasure P] (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) (n1 d : ℕ) :
    P.map (stageTwoSum ξ n1 d) = gaussianReal 0 (d : ℝ≥0) := by
  have h := map_partialSum_sub hξ hlaw hindep (Nat.le_add_right n1 d)
  have e : stageTwoSum ξ n1 d = fun ω => partialSum ξ (n1 + d) ω - partialSum ξ n1 ω := rfl
  rw [e]
  simpa using h

/-- Rescaling: `N(0, d)` is the law of `√d` times a standard normal variable. -/
lemma gaussianReal_natCast_apply (d : ℕ) {T : Set ℝ} (hT : MeasurableSet T) :
    gaussianReal 0 (d : ℝ≥0) T = gaussianReal 0 1 ((fun u => √(d : ℝ) * u) ⁻¹' T) := by
  have h := gaussianReal_map_const_mul (μ := 0) (v := 1) (√(d : ℝ))
  have hv : NNReal.mk (√(d : ℝ) ^ 2) (sq_nonneg _) * 1 = (d : ℝ≥0) := by
    apply NNReal.eq
    rw [NNReal.coe_mul, NNReal.coe_mk, NNReal.coe_one, mul_one,
      Real.sq_sqrt (Nat.cast_nonneg d), NNReal.coe_natCast]
  rw [hv, mul_zero] at h
  rw [← h, Measure.map_apply (measurable_const_mul _) hT]

/-- The **conditional error function** of the one-sided z-test with first-stage size `n1`,
second-stage size `m` and critical value `c`: `A(z) = N(0,1) [critValue n1 c z m, ∞)`, as an
extended nonnegative real. In terms of the standard normal distribution function,
`A(z) = 1 - Φ((c √(n1 + m) - z √n1) / √m)`. -/
noncomputable def condError (n1 : ℕ) (c z m : ℝ) : ℝ≥0∞ :=
  gaussianReal 0 1 (Set.Ici (critValue n1 c z m))

/-- The conditional error function is `1 - Φ` of the second-stage critical value. -/
theorem condError_eq_one_sub_cdf (n1 : ℕ) (c z m : ℝ) :
    condError n1 c z m =
      ENNReal.ofReal (1 - cdf (gaussianReal 0 1) (critValue n1 c z m)) := by
  set a := critValue n1 c z m
  have h1 : gaussianReal 0 1 (Set.Iio a) = ENNReal.ofReal (cdf (gaussianReal 0 1) a) := by
    rw [ofReal_cdf, ← Set.Iio_union_right, measure_union (by simp) (measurableSet_singleton a)]
    have : gaussianReal 0 1 {a} = 0 :=
      gaussianReal_absolutelyContinuous 0 one_ne_zero Real.volume_singleton
    rw [this, add_zero]
  have h2 : Set.Ici a = (Set.Iio a)ᶜ := by ext x; simp
  unfold condError
  rw [h2, prob_compl_eq_one_sub measurableSet_Iio, h1,
    ENNReal.ofReal_sub _ (cdf_nonneg _ _), ENNReal.ofReal_one]

/-- In the promising zone the conditional error does not increase with the second-stage
size. -/
theorem condError_le_condError (n1 : ℕ) {c z n2 m : ℝ} (hc : 0 ≤ c) (hn2 : 0 < n2)
    (hnm : n2 ≤ m) (hz : c * √((n1 : ℝ) / (n1 + n2)) ≤ z) :
    condError n1 c z m ≤ condError n1 c z n2 :=
  measure_mono (Set.Ici_subset_Ici.mpr (critValue_le_critValue n1 hc hn2 hnm hz))

variable [IsProbabilityMeasure P]

/-- **Conditional error function of the two-stage z-test, set form.** Independent standard
normal `ξ i`, first stage of size `n1 > 0`, second stage of size `d > 0`. For every event `B`
in the first-stage σ-algebra, the probability that `B` occurs and the final z-statistic
`Z (n1 + d)` is at least `c` is the integral over `B` of the conditional error function
evaluated at the first-stage z-statistic. -/
theorem measure_inter_reject_eq_lintegral_condError (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n1 d : ℕ}
    (hn1 : 0 < n1) (hd : 0 < d) (c : ℝ) {B : Set Ω} (hB : MeasurableSet[firstStage ξ n1] B) :
    P (B ∩ {ω | c ≤ zStat ξ (n1 + d) ω}) =
      ∫⁻ ω in B, condError n1 c (zStat ξ n1 ω) d ∂P := by
  have hn1r : (0 : ℝ) < n1 := by exact_mod_cast hn1
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  have hsd : 0 < √(d : ℝ) := Real.sqrt_pos.mpr hdr
  have hsn : 0 < √(n1 : ℝ) := Real.sqrt_pos.mpr hn1r
  have hsnd : 0 < √((n1 : ℝ) + d) := Real.sqrt_pos.mpr (by positivity)
  set S : Set (ℝ × ℝ) := {p | c * √((n1 : ℝ) + d) ≤ p.1 + p.2} with hS
  have hSm : MeasurableSet S := measurableSet_le measurable_const (measurable_fst.add measurable_snd)
  have hset : {ω | c ≤ zStat ξ (n1 + d) ω} =
      (fun ω => (partialSum ξ n1 ω, stageTwoSum ξ n1 d ω)) ⁻¹' S := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_preimage, hS, zStat, stageTwoSum, Nat.cast_add]
    rw [le_div_iff₀ hsnd]
    constructor <;> intro h <;> linarith
  rw [hset, measure_inter_preimage_prodMk_of_indep (firstStage_le hξ n1)
    (measurable_firstStage_partialSum ξ n1) (measurable_stageTwoSum hξ n1 d)
    (indep_firstStage_stageTwoSum hξ hindep n1 d) hB hSm, map_stageTwoSum hξ hlaw hindep]
  refine lintegral_congr fun ω => ?_
  rw [gaussianReal_natCast_apply d (measurable_prodMk_left hSm)]
  unfold condError
  congr 1
  ext u
  simp only [Set.mem_preimage, hS, Set.mem_ofPred_eq, Set.mem_Ici, critValue, zStat]
  rw [div_le_iff₀ hsd, div_mul_cancel₀ _ hsn.ne']
  constructor <;> intro h <;> linarith

/-- The fixed-design one-sided z-test has level `N(0,1) [c, ∞)`. -/
theorem measure_reject_fixed (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n : ℕ} (hn : 0 < n)
    (c : ℝ) : P {ω | c ≤ zStat ξ n ω} = gaussianReal 0 1 (Set.Ici c) := by
  have hm : Measurable (zStat ξ n) := (measurable_partialSum hξ n).div_const _
  rw [← map_zStat hξ hlaw hindep hn, Measure.map_apply hm measurableSet_Ici]
  rfl

/-- **Sample-size increase with the conventional test (Chen–DeMets–Lan).** Independent standard
normal observations; first stage of size `n1 > 0`, planned second stage of size `n2 > 0`,
critical value `c ≥ 0`. The actual second-stage size `N2` may depend on all first-stage data
(it is measurable with respect to the first-stage σ-algebra), is never below `n2`, and differs
from `n2` only when the first-stage z-statistic is at least `c √(n1 / (n1 + n2))`. Then the
conventional final test, which rejects when the ordinary z-statistic of all `n1 + N2`
observations is at least `c`, has type I error at most `N(0,1) [c, ∞)`, the level of the
fixed design. -/
theorem measure_conventional_adaptive_le (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n1 n2 : ℕ}
    (hn1 : 0 < n1) (hn2 : 0 < n2) {c : ℝ} (hc : 0 ≤ c) {N2 : Ω → ℕ}
    (hN2 : Measurable[firstStage ξ n1] N2) (hge : ∀ ω, n2 ≤ N2 ω)
    (hzone : ∀ ω, N2 ω ≠ n2 → c * √((n1 : ℝ) / (n1 + n2)) ≤ zStat ξ n1 ω) :
    P {ω | c ≤ zStat ξ (n1 + N2 ω) ω} ≤ gaussianReal 0 1 (Set.Ici c) := by
  have hD : ∀ d, MeasurableSet[firstStage ξ n1] (N2 ⁻¹' {d}) := fun d =>
    hN2 (measurableSet_singleton d)
  have hset : {ω | c ≤ zStat ξ (n1 + N2 ω) ω} =
      ⋃ d, N2 ⁻¹' {d} ∩ {ω | c ≤ zStat ξ (n1 + d) ω} := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_preimage,
      Set.mem_singleton_iff]
    constructor
    · intro h; exact ⟨N2 ω, rfl, h⟩
    · rintro ⟨d, rfl, h⟩; exact h
  rw [hset, ← measure_reject_fixed hξ hlaw hindep (Nat.add_pos_left hn1 n2) c]
  refine measure_iUnion_selected_le (firstStage_le hξ n1) hD fun d B hB hBd => ?_
  rcases B.eq_empty_or_nonempty with rfl | ⟨ω₀, hω₀⟩
  · simp
  have hd : n2 ≤ d := by
    have := hBd hω₀
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at this
    exact this ▸ hge ω₀
  rw [measure_inter_reject_eq_lintegral_condError hξ hlaw hindep hn1 (hn2.trans_le hd) c hB,
    measure_inter_reject_eq_lintegral_condError hξ hlaw hindep hn1 hn2 c hB]
  refine setLIntegral_mono' ((firstStage_le hξ n1) _ hB) fun ω hω => ?_
  have hωd : N2 ω = d := hBd hω
  rcases eq_or_ne d n2 with rfl | hne
  · exact le_rfl
  · exact condError_le_condError n1 hc (by exact_mod_cast hn2) (by exact_mod_cast hd)
      (hzone ω (hωd ▸ hne))

/-- The same statement for a second-stage size that is a measurable function of the first-stage
z-statistic alone. -/
theorem measure_conventional_adaptive_le_of_zStat (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n1 n2 : ℕ}
    (hn1 : 0 < n1) (hn2 : 0 < n2) {c : ℝ} (hc : 0 ≤ c) {N2 : ℝ → ℕ} (hN2 : Measurable N2)
    (hge : ∀ z, n2 ≤ N2 z) (hzone : ∀ z, N2 z ≠ n2 → c * √((n1 : ℝ) / (n1 + n2)) ≤ z) :
    P {ω | c ≤ zStat ξ (n1 + N2 (zStat ξ n1 ω)) ω} ≤ gaussianReal 0 1 (Set.Ici c) :=
  measure_conventional_adaptive_le (N2 := fun ω => N2 (zStat ξ n1 ω)) hξ hlaw hindep hn1 hn2 hc
    (hN2.comp (measurable_firstStage_zStat ξ n1)) (fun _ => hge _) (fun _ => hzone _)

/-- The second-stage z-statistic computed from the `d` second-stage observations. -/
noncomputable def stageTwoZ (ξ : ℕ → Ω → ℝ) (n1 d : ℕ) (ω : Ω) : ℝ :=
  stageTwoSum ξ n1 d ω / √(d : ℝ)

omit [IsProbabilityMeasure P] in
/-- With the planned second-stage size the weighted statistic is the ordinary z-statistic. -/
theorem weighted_eq_zStat (ξ : ℕ → Ω → ℝ) {n1 n2 : ℕ} (hn2 : 0 < n2) (ω : Ω) :
    (√(n1 : ℝ) * zStat ξ n1 ω + √(n2 : ℝ) * stageTwoZ ξ n1 n2 ω) / √((n1 : ℝ) + n2) =
      zStat ξ (n1 + n2) ω := by
  have h2 : 0 < √(n2 : ℝ) := Real.sqrt_pos.mpr (by exact_mod_cast hn2)
  rcases Nat.eq_zero_or_pos n1 with rfl | hn1
  · simp only [zStat, stageTwoZ, stageTwoSum, Nat.cast_zero, Real.sqrt_zero, zero_mul, zero_add,
      mul_div_cancel₀ _ h2.ne']
    simp [partialSum]
  · have h1 : 0 < √(n1 : ℝ) := Real.sqrt_pos.mpr (by exact_mod_cast hn1)
    simp only [zStat, stageTwoZ, stageTwoSum, Nat.cast_add, mul_div_cancel₀ _ h2.ne',
      mul_div_cancel₀ _ h1.ne']
    ring

/-- **The test with pre-planned weights keeps the level exactly (Cui–Hung–Wang,
Lehmacher–Wassmer).** Independent standard normal observations; first stage of size `n1 > 0`,
planned second stage of size `n2 > 0`, any critical value `c`. The actual second-stage size
`N2 > 0` may be any function of the first-stage data. The test that combines the two stage-wise
z-statistics with the *planned* weights, rejecting when
`(√n1 Z₁ + √n2 Z₂) / √(n1 + n2) ≥ c` with `Z₂` the z-statistic of the `N2` second-stage
observations, has type I error exactly `N(0,1) [c, ∞)`: its conditional error function is that
of the fixed design whatever `N2` is. -/
theorem measure_weighted_adaptive_eq (hξ : ∀ i, Measurable (ξ i))
    (hlaw : ∀ i, P.map (ξ i) = gaussianReal 0 1) (hindep : iIndepFun ξ P) {n1 n2 : ℕ}
    (hn1 : 0 < n1) (hn2 : 0 < n2) (c : ℝ) {N2 : Ω → ℕ}
    (hN2 : Measurable[firstStage ξ n1] N2) (hpos : ∀ ω, 0 < N2 ω) :
    P {ω | c ≤ (√(n1 : ℝ) * zStat ξ n1 ω + √(n2 : ℝ) * stageTwoZ ξ n1 (N2 ω) ω) /
        √((n1 : ℝ) + n2)} = gaussianReal 0 1 (Set.Ici c) := by
  have hn1r : (0 : ℝ) < n1 := by exact_mod_cast hn1
  have hn2r : (0 : ℝ) < n2 := by exact_mod_cast hn2
  have hsn1 : 0 < √(n1 : ℝ) := Real.sqrt_pos.mpr hn1r
  have hsn2 : 0 < √(n2 : ℝ) := Real.sqrt_pos.mpr hn2r
  have hsn : 0 < √((n1 : ℝ) + n2) := Real.sqrt_pos.mpr (by positivity)
  have hD : ∀ d, MeasurableSet[firstStage ξ n1] (N2 ⁻¹' {d}) := fun d =>
    hN2 (measurableSet_singleton d)
  set E' : ℕ → Set Ω := fun d => {ω | c ≤ (√(n1 : ℝ) * zStat ξ n1 ω +
    √(n2 : ℝ) * stageTwoZ ξ n1 d ω) / √((n1 : ℝ) + n2)} with hE'
  have hset : {ω | c ≤ (√(n1 : ℝ) * zStat ξ n1 ω + √(n2 : ℝ) * stageTwoZ ξ n1 (N2 ω) ω) /
        √((n1 : ℝ) + n2)} = ⋃ d, N2 ⁻¹' {d} ∩ E' d := by
    ext ω
    simp only [hE', Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_preimage,
      Set.mem_singleton_iff]
    constructor
    · intro h; exact ⟨N2 ω, rfl, h⟩
    · rintro ⟨d, rfl, h⟩; exact h
  have hmeasZ : ∀ d, Measurable (stageTwoZ ξ n1 d) := fun d =>
    (measurable_stageTwoSum hξ n1 d).div_const _
  have hmeas1 : Measurable (zStat ξ n1) := (measurable_partialSum hξ n1).div_const _
  have hE'm : ∀ d, MeasurableSet (E' d) := fun d =>
    measurableSet_le measurable_const
      (((hmeas1.const_mul _).add ((hmeasZ d).const_mul _)).div_const _)
  rw [hset, ← measure_reject_fixed hξ hlaw hindep (Nat.add_pos_left hn1 n2) c]
  refine measure_iUnion_selected_eq (firstStage_le hξ n1) hD hE'm fun d => ?_
  rcases (N2 ⁻¹' {d}).eq_empty_or_nonempty with he | ⟨ω₀, hω₀⟩
  · simp [he]
  have hd : 0 < d := by
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hω₀
    exact hω₀ ▸ hpos ω₀
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  have hsd : 0 < √(d : ℝ) := Real.sqrt_pos.mpr hdr
  rw [measure_inter_reject_eq_lintegral_condError hξ hlaw hindep hn1 hn2 c (hD d)]
  set S : Set (ℝ × ℝ) :=
    {p | c * √((n1 : ℝ) + n2) ≤ p.1 + √(n2 : ℝ) * (p.2 / √(d : ℝ))} with hS
  have hSm : MeasurableSet S := measurableSet_le measurable_const
    (measurable_fst.add ((measurable_snd.div_const _).const_mul _))
  have hpre : E' d = (fun ω => (partialSum ξ n1 ω, stageTwoSum ξ n1 d ω)) ⁻¹' S := by
    ext ω
    simp only [hE', Set.mem_ofPred_eq, Set.mem_preimage, hS, zStat, stageTwoZ]
    rw [le_div_iff₀ hsn, mul_div_cancel₀ _ hsn1.ne']
  rw [hpre, measure_inter_preimage_prodMk_of_indep (firstStage_le hξ n1)
    (measurable_firstStage_partialSum ξ n1) (measurable_stageTwoSum hξ n1 d)
    (indep_firstStage_stageTwoSum hξ hindep n1 d) (hD d) hSm, map_stageTwoSum hξ hlaw hindep]
  refine lintegral_congr fun ω => ?_
  rw [gaussianReal_natCast_apply d (measurable_prodMk_left hSm)]
  unfold condError
  congr 1
  ext u
  simp only [Set.mem_preimage, hS, Set.mem_ofPred_eq, Set.mem_Ici, critValue, zStat,
    mul_div_cancel_left₀ _ hsd.ne']
  rw [div_le_iff₀ hsn2, div_mul_cancel₀ _ hsn1.ne']
  constructor <;> intro h <;> linarith

end Gaussian

